@page "/confirm-email"
@inject HttpClient Http

<PageTitle>Confirm email | GuildArena</PageTitle>

<div class="auth-page">
    <header class="auth-intro">
        <p class="auth-eyebrow">Account verification</p>
        <h1>Confirm your email</h1>
    </header>
    <section class="auth-card" aria-label="Email confirmation result">
        @if (_isLoading)
        {
            <div role="status">
                <h2>Checking your link...</h2>
                <p>Confirming your email address.</p>
            </div>
        }
        else if (_isSuccess)
        {
            <div class="auth-feedback success" role="status">
                <h2>Email confirmed</h2>
                <p>You can now sign in to your account.</p>
            </div>
            <a href="/login" class="auth-action auth-wide">Sign in</a>
        }
        else
        {
            <div class="auth-feedback error" role="alert">
                <h2>Unable to confirm email</h2>
                <p>@(_isConnectionError ? "We couldn't reach the server. Try checking the link again." : "The link is incomplete, invalid, expired, or has already been used.")</p>
            </div>
            @if (_isConnectionError)
            {
                <button type="button" class="auth-action auth-wide" @onclick="ConfirmAsync">Try again</button>
            }
            <div class="auth-footer"><a href="/login">Go to sign in</a> <span>Already signed in? Request another link in account settings.</span></div>
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery] public string? UserId { get; set; }
    [SupplyParameterFromQuery] public string? Code { get; set; }

    private bool _isLoading = true;
    private bool _isSuccess;
    private bool _isConnectionError;

    protected override Task OnParametersSetAsync() => ConfirmAsync();

    private async Task ConfirmAsync()
    {
        _isLoading = true;
        _isConnectionError = false;
        if (string.IsNullOrEmpty(UserId) || string.IsNullOrEmpty(Code))
        {
            _isLoading = false;
            _isSuccess = false;
            return;
        }

        try
        {
            var response = await Http.GetAsync($"confirmEmail?userId={Uri.EscapeDataString(UserId)}&code={Uri.EscapeDataString(Code)}");
            _isSuccess = response.IsSuccessStatusCode;
        }
        catch
        {
            _isSuccess = false;
            _isConnectionError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
