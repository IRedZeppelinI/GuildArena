@page "/reset-password"
@using GuildArena.Shared.Requests
@inject HttpClient Http

<PageTitle>Reset password | GuildArena</PageTitle>

<div class="auth-page">
    <header class="auth-intro">
        <p class="auth-eyebrow">Account recovery</p>
        <h1>Set a new password</h1>
        <p>Choose a password to regain access to your account.</p>
    </header>
    <section class="auth-card" aria-label="Reset password">
        @if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Code))
        {
            <div class="auth-feedback error" role="alert">
                <h2>Invalid link</h2>
                <p>This reset link is incomplete. Request a new one to continue.</p>
            </div>
            <a href="/forgot-password" class="auth-action auth-wide">Request a new link</a>
        }
        else if (_isSuccess)
        {
            <div class="auth-feedback success" role="status">
                <h2>Password updated</h2>
                <p>You can now sign in with your new password.</p>
            </div>
            <a href="/login" class="auth-action auth-wide">Sign in</a>
        }
        else
        {
            <p>Resetting the password for <strong class="account-email">@Email</strong>.</p>
            <form @onsubmit="ExecuteResetAsync" @onsubmit:preventDefault="true">
                @if (_errorMessage is not null)
                {
                    <div class="auth-feedback error" role="alert">@_errorMessage</div>
                }
                <div class="auth-field">
                    <label for="reset-password">New password</label>
                    <input id="reset-password" name="newPassword" type="password" autocomplete="new-password" @bind="_newPassword" required aria-describedby="reset-password-help" disabled="@_isLoading" />
                    <p id="reset-password-help" class="auth-hint">Choose a strong, unique password. Password requirements are checked when you submit.</p>
                </div>
                <div class="auth-field">
                    <label for="reset-confirm">Confirm new password</label>
                    <input id="reset-confirm" name="confirmPassword" type="password" autocomplete="new-password" @bind="_confirmPassword" required disabled="@_isLoading" />
                </div>
                <button type="submit" class="auth-action auth-wide" disabled="@_isLoading">@(_isLoading ? "Updating password..." : "Set new password")</button>
                @if (_isLoading)
                {
                    <p class="auth-hint" role="status">Updating your password...</p>
                }
            </form>
            <div class="auth-footer"><a href="/forgot-password">Request another link</a></div>
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Code { get; set; }

    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _isLoading;
    private bool _isSuccess;
    private string? _errorMessage;

    private async Task ExecuteResetAsync()
    {
        _errorMessage = null;
        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "The passwords do not match.";
            return;
        }

        _isLoading = true;
        try
        {
            var request = new ResetPasswordRequest { Email = Email!, ResetCode = Code!, NewPassword = _newPassword };
            var response = await Http.PostAsJsonAsync("resetPassword", request);
            if (response.IsSuccessStatusCode)
            {
                _isSuccess = true;
                _newPassword = _confirmPassword = string.Empty;
            }
            else
            {
                _errorMessage = "We couldn't reset your password. Check the password requirements, or request a new link if this one has expired.";
            }
        }
        catch
        {
            _errorMessage = "Connection unavailable. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
