@page "/arena"
@layout GuildArena.Web.Layout.ArenaLayout
@using GuildArena.Domain.Enums.Resources
@using GuildArena.Shared.DTOs.Combat
@using GuildArena.Web.Pages.Arena.Components
@using GuildArena.Web.Pages.Arena.State
@using GuildArena.Web.State
@using MatchType = GuildArena.Domain.Enums.Matches.MatchType
@inject ICombatStateService CombatState
@inject NavigationManager NavManager
@implements IDisposable

<PageTitle>Battle Arena</PageTitle>

@if (CombatState.CombatResult != null)
{
    <CombatResultModal Result="CombatState.CombatResult" IsPending="@(CombatState.IsCommandPending || _leavingArena)" ReturnToDungeon="@(CombatState.MatchType == MatchType.Dungeon)" OnReturnClicked="LeaveArena" />
}


@if (_checkingCombat)
{
    <div class="startup-screen">
        <div class="startup-box" role="status">Checking for an active combat...</div>
    </div>
}
else if (_resumeError)
{
    <div class="startup-screen">
        <div class="startup-box" role="alert">
            <h3 class="text-warning">Unable to reconnect</h3>
            <p class="text-light">We couldn't restore your combat. Check your connection and try again.</p>
            <button class="btn btn-outline-info mt-3" @onclick="ResumeCombatAsync">Try reconnecting</button>
        </div>
    </div>
}
else if (CombatState.IsCombatUnavailable && CombatState.CombatResult is null)
{
    <div class="startup-screen">
        <div class="startup-box" role="status">
            <h3 class="text-warning">Combat no longer active</h3>
            <p class="text-light">The server confirmed there is no active combat. The battle may have ended or expired; its result could not be recovered.</p>
            <button class="btn btn-outline-info mt-3" disabled="@(CombatState.IsCommandPending || _leavingArena)" @onclick="LeaveArena">
                @(CombatState.MatchType == MatchType.Dungeon ? "Return to Dungeons" : "Return to Encounters")
            </button>
        </div>
    </div>
}
else if (string.IsNullOrEmpty(CombatState.CombatId))
{
    <div class="startup-screen">
        <div class="startup-box">
            <h3 class="text-warning">No active combat</h3>
            <p class="text-light">Please select your heroes in the Lobby first.</p>
            <a class="btn btn-outline-info mt-3" href="/encounters">Go to Encounters</a>
        </div>
    </div>
}
else
{
    <ArenaModals ShowMobileLogs="_showMobileLogs"
                 BattleLogs="CombatState.BattleLogs"
                 OnCloseMobileLogs="ToggleMobileLogs"
                  ShowExchangeModal="_showExchangeModal"
                  IsPending="@CombatState.IsCommandPending"
                  Feedback="@ActionFeedback"
                 PlayerEssencePool="LocalPlayerEssencePool"
                 OnConfirmExchange="ExecuteExchangeAsync"
                 OnCancelExchange="() => _showExchangeModal = false"
                 ShowPaymentModal="_showPaymentModal"
                 AvailableEssenceForPayment="_availableEssenceForPayment"
                 NeutralCostPending="_neutralCostPending"
                 OnConfirmPayment="ProcessManualPaymentAndExecute"
                  OnCancelPayment="CancelPayment" />

    <ArenaBoard GameState="CombatState.GameState"
                SelectedCombatantId="_selectedCombatantId"
                LocalPlayerId="LocalPlayerId"
                TargetingState="_targetingState"
                OnBackgroundClicked="CancelTargeting"
                 IsActivationBlocked="@(ActionsBlocked || _showPaymentModal || _showExchangeModal)"
                 OnExchangeRequested="OpenExchange"
                OnAbilityActivated="StartTargeting"
                OnCombatantClicked="SelectTarget"
                OnCombatantSelected="SelectCombatant"
                OnInspectAbility="ShowAbilityTooltip" 
                OnCombatantHovered="ShowCombatantTooltip"
                OnInspectCombatantRequested="InspectCombatantAsync"
                 OnInspectEffectsRequested="InspectEffectsAsync">
        <ActionFeedback>
            <div class="action-feedback @(HasActionError ? "action-error" : "")" role="status" aria-live="polite" aria-atomic="true" @onclick:stopPropagation="true">
                <span class="feedback-message" tabindex="0" aria-label="Action feedback">@ActionFeedback</span>
                @if ((CombatState.RequiresSynchronization || !CombatState.IsConnected || LocalPlayerEssencePool is null) && !CombatState.IsCommandPending)
                {
                    <button type="button" disabled="@CombatState.IsConnecting" @onclick="RefreshCombatAsync">@(CombatState.IsConnecting ? "Reconnecting…" : "Refresh combat")</button>
                }
            </div>
        </ActionFeedback>
    </ArenaBoard>

    <ArenaFooter @ref="_footer" InspectedAbility="_inspectedAbility"
                 SelectedCombatant="SelectedCombatant"
                 IsActivationBlocked="@(ActionsBlocked || _showPaymentModal || _showExchangeModal)"
                 IsCommandPending="@CombatState.IsCommandPending"
                 OnAbilityActivated="StartTargeting"
                 OnInspectAbility="ShowAbilityTooltip"
                 OnInspectAbilityRequested="InspectAbilityAsync"
                 OnInspectSelectedCombatant="InspectSelectedCombatantAsync"
                 InspectedCombatant="_inspectedCombatant" 
                 BattleLogs="CombatState.BattleLogs"
                 IsLocalPlayerTurn="IsLocalPlayerTurn"
                 IsTargetingActive="_targetingState.IsActive"
                 OnToggleMobileLogs="ToggleMobileLogs"
                 OnCancelTargeting="CancelTargeting"
                 OnEndTurn="EndTurnAsync" />
}

@code {
    private bool _showMobileLogs = false;
    private bool _showExchangeModal = false;
    private bool _showPaymentModal = false;
    private bool _checkingCombat = true;
    private bool _resumeError;
    private GameStateDto? _lastSnapshot;
    private bool _submittingPreparedAction;
    private bool _leavingArena;
    private string? _interactionFeedback;
    private string? _recoveryFeedback;
    private bool ActionsBlocked => CombatState.IsCommandPending || CombatState.IsConnecting ||
        CombatState.RequiresSynchronization || !CombatState.IsConnected || CombatState.IsCombatUnavailable || CombatState.CombatResult is not null;
    private bool HasActionError => _recoveryFeedback is not null || CombatState.LastCommandResult?.Outcome is CombatCommandOutcome.Rejected or CombatCommandOutcome.Unconfirmed;
    private string ActionFeedback
    {
        get
        {
            if (CombatState.IsCommandPending)
                return $"{CombatState.PendingCommandName}… Waiting for the server.";
            if (CombatState.IsConnecting)
                return "Restoring combat connection…";
            if (_recoveryFeedback is not null) return _recoveryFeedback;
            if (!CombatState.IsConnected)
                return "Combat connection lost. Actions are paused until the connection and state are restored.";
            if (CombatState.RequiresSynchronization)
            {
                var message = CombatState.LastCommandResult?.Message ?? "Combat state needs refreshing.";
                return CombatState.LastCommandResult?.Outcome == CombatCommandOutcome.Unconfirmed
                    ? message : $"{message} Refresh combat to continue.";
            }
            if (_interactionFeedback is not null) return _interactionFeedback;
            if (_targetingState.PendingRule is { } rule)
                return $"{_targetingState.ActiveAbility!.Name}: choose {rule.Type} targets ({_targetingState.PendingRuleSelectedCount}/{rule.Count}). Choice {_targetingState.PendingRuleNumber}/{_targetingState.ManualRuleCount}.";
            return CombatState.LastCommandResult?.Message ?? (IsLocalPlayerTurn
                ? "Your turn. Choose an ability or end your turn."
                : "Enemy turn. You can inspect heroes, abilities and the battle log.");
        }
    }

    private int _neutralCostPending = 0;
    private Dictionary<EssenceType, int>? _availableEssenceForPayment;

    private AbilitySummaryDto? _inspectedAbility;
    private int? _inspectedAbilitySourceId;
    private CombatantDto? _inspectedCombatant; 
    private int? _selectedCombatantId;
    private CombatantDto? SelectedCombatant => CombatState.GameState?.Combatants.FirstOrDefault(c => c.Id == _selectedCombatantId);
    private ArenaFooter? _footer;
    
    private readonly TargetingStateManager _targetingState = new();

    private int LocalPlayerId => 1;

    private bool IsLocalPlayerTurn =>
        CombatState.GameState != null && CombatState.GameState.CurrentPlayerId == LocalPlayerId;

    private Dictionary<EssenceType, int>? LocalPlayerEssencePool =>
        CombatState.GameState?.Players.FirstOrDefault(p => p.PlayerId == LocalPlayerId)?.EssencePool;

    protected override void OnInitialized()
    {
        CombatState.OnChange += OnCombatStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(CombatState.CombatId))
            await ResumeCombatAsync();
        else
            _checkingCombat = false;
        EnsureSelectedCombatant();
        RefreshPreparedAction();
    }

    private void RefreshPreparedAction()
    {
        var snapshot = CombatState.GameState;
        if ((!CombatState.IsConnected || CombatState.IsCombatUnavailable || CombatState.CombatResult is not null ||
            CombatState.LastCommandResult?.Outcome == CombatCommandOutcome.Unconfirmed) && !CombatState.IsCommandPending)
        {
            CancelPreparedAction();
            _showExchangeModal = false;
        }
        else if (CombatState.RequiresSynchronization && !CombatState.IsCommandPending && !_submittingPreparedAction)
        {
            if (_showPaymentModal)
            {
                CancelPreparedAction();
                _interactionFeedback = "Combat changed during payment. Choose the ability again using the current costs and targets.";
            }
            if (_showExchangeModal)
            {
                _showExchangeModal = false;
                _interactionFeedback = "Combat changed during the exchange. Open exchange again to use the current essences.";
            }
            // Keep manual choices blocked until the coordinated GET supplies current eligibility.
            // Do not consume this snapshot here; it must be reconciled after synchronization.
            return;
        }
        else if (!CombatState.IsCommandPending && !_submittingPreparedAction && !ReferenceEquals(_lastSnapshot, snapshot))
        {
            if (_showPaymentModal)
            {
                CancelPreparedAction();
                _interactionFeedback = "Combat changed during payment. Choose the ability again using the current costs and targets.";
            }
            else if (_targetingState.IsActive)
            {
                if (!_targetingState.Refresh(snapshot, LocalPlayerId))
                    _interactionFeedback = "The prepared ability is no longer available. Choose another action.";
                else if (_targetingState.IsComplete)
                {
                    CancelPreparedAction();
                    _interactionFeedback = "Target requirements changed. Choose the ability again to confirm the current targets.";
                }
            }
            if (_showExchangeModal)
            {
                _showExchangeModal = false;
                _interactionFeedback = "Combat changed during the exchange. Open exchange again to use the current essences.";
            }
        }
        _lastSnapshot = snapshot;
    }

    private async Task ResumeCombatAsync()
    {
        _checkingCombat = true;
        _resumeError = false;
        try
        {
            var active = await CombatState.CheckActiveCombatAsync();
            if (active is null)
                _resumeError = true;
            else if (active.HasActiveCombat && !await CombatState.RejoinCombatAsync(active.CombatId!, active.MatchType))
                _resumeError = true;
        }
        finally
        {
            _checkingCombat = false;
        }
    }

    public void Dispose()
    {
        CombatState.OnChange -= OnCombatStateChanged;
    }

    private void OnCombatStateChanged() => _ = InvokeAsync(() =>
    {
        // Also clear local messages for commands initiated by the layout (surrender).
        if (CombatState.IsCommandPending || CombatState.IsConnecting)
        {
            _interactionFeedback = null;
            _recoveryFeedback = null;
        }
        else if (!CombatState.RequiresSynchronization && CombatState.IsConnected)
            _recoveryFeedback = null;
        EnsureSelectedCombatant();
        RefreshPreparedAction();
        // Inspection may stay open during server updates. Render the current snapshot,
        // rather than holding on to the object that was originally hovered.
        if (_inspectedCombatant is not null)
            _inspectedCombatant = CombatState.GameState?.Combatants.FirstOrDefault(c => c.Id == _inspectedCombatant.Id);

        if (_inspectedAbility is not null)
        {
            var source = CombatState.GameState?.Combatants.FirstOrDefault(c => c.Id == _inspectedAbilitySourceId);
            _inspectedAbility = source?.Abilities.FirstOrDefault(a => a.Id == _inspectedAbility.Id)
                ?? (source?.SpecialAbility?.Id == _inspectedAbility.Id ? source.SpecialAbility : null);
        }
        StateHasChanged();
    });

    private void EnsureSelectedCombatant()
    {
        if (SelectedCombatant is not null) return;
        var team = CombatState.GameState?.Combatants.Where(c => c.OwnerId == LocalPlayerId);
        _selectedCombatantId = (team?.FirstOrDefault(c => c.IsAlive) ?? team?.FirstOrDefault())?.Id;
    }

    private void SelectCombatant(CombatantDto combatant)
    {
        if (_targetingState.IsActive || combatant.OwnerId != LocalPlayerId) return;
        _selectedCombatantId = combatant.Id;
        ShowCombatantTooltip(combatant);
    }

    private void ShowAbilityTooltip(AbilitySummaryDto? ability)
    {
        if (ability != null)
        {
            _inspectedAbility = ability;
            _inspectedAbilitySourceId = CombatState.GameState?.Combatants
                .FirstOrDefault(c => c.SpecialAbility == ability || c.Abilities.Contains(ability))?.Id;
            _inspectedCombatant = null;
        }
    }

    private void ShowCombatantTooltip(CombatantDto? combatant)
    {
        if (combatant != null)
        {
            _inspectedCombatant = combatant;
            _inspectedAbility = null;
            _inspectedAbilitySourceId = null;
        }
    }
    private void ToggleMobileLogs() => _showMobileLogs = !_showMobileLogs;

    private async Task InspectAbilityAsync(AbilitySummaryDto ability)
    {
        ShowAbilityTooltip(ability);
        if (_footer is not null)
            await _footer.ShowInspectionAsync();
    }

    private Task InspectSelectedCombatantAsync() => SelectedCombatant is { } combatant
        ? InspectCombatantAsync(combatant)
        : Task.CompletedTask;

    private async Task InspectCombatantAsync(CombatantDto combatant)
    {
        ShowCombatantTooltip(combatant);
        if (_footer is not null)
            await _footer.ShowInspectionAsync();
    }

    private async Task InspectEffectsAsync(CombatantDto combatant)
    {
        ShowCombatantTooltip(combatant);
        if (_footer is not null)
            await _footer.ShowEffectsAsync();
    }

    private async Task EndTurnAsync()
    {
        if (ActionsBlocked || !IsLocalPlayerTurn || _showPaymentModal || _showExchangeModal || _targetingState.IsActive) return;
        _interactionFeedback = null;
        await CombatState.EndTurnAsync();
    }

    private async Task RefreshCombatAsync()
    {
        CancelPreparedAction();
        _showExchangeModal = false;
        _interactionFeedback = null;
        _recoveryFeedback = null;
        var refreshed = await CombatState.RefreshCombatAsync();
        _interactionFeedback = refreshed
            ? "Combat refreshed. Review the current state before choosing another action. No command was repeated."
            : null;
        _recoveryFeedback = refreshed ? null : "Unable to refresh combat. Check your connection and try again.";
    }

    private async Task StartTargeting((int SourceId, string AbilityId) payload)
    {
        if (!IsLocalPlayerTurn || ActionsBlocked || _showPaymentModal || _showExchangeModal) return;

        var source = CombatState.GameState?.Combatants.FirstOrDefault(c => c.Id == payload.SourceId);
        if (source is null || source.OwnerId != LocalPlayerId || !source.IsAlive) return;
        var ability = source.Abilities.FirstOrDefault(a => a.Id == payload.AbilityId)
            ?? (source.SpecialAbility?.Id == payload.AbilityId ? source.SpecialAbility : null);

        if (ability == null || !ability.IsAffordable || ability.CurrentCooldownTurns > 0) return;

        _selectedCombatantId = source.Id;
        _interactionFeedback = null;
        _targetingState.StartTargeting(payload.SourceId, ability);

        if (!_targetingState.RequiresTargetSelection)
        {
            await TransitionToPaymentOrExecuteAsync();
        }
    }

    private async Task SelectTarget(CombatantDto target)
    {
        if (ActionsBlocked || _showPaymentModal || _showExchangeModal || !_targetingState.Refresh(CombatState.GameState, LocalPlayerId)) return;
        if (_targetingState.TrySelectTarget(target, out bool allRulesSatisfied) && allRulesSatisfied)
        {
            await TransitionToPaymentOrExecuteAsync();
        }
    }

    private void CancelTargeting()
    {
        if (CombatState.IsCommandPending || (!_targetingState.IsActive && !_showPaymentModal)) return;
        CancelPreparedAction();
        _interactionFeedback = "Action cancelled. No command was sent.";
    }

    private void CancelPreparedAction()
    {
        _showPaymentModal = false;
        _availableEssenceForPayment = null;
        _targetingState.Cancel();
    }

    private async Task TransitionToPaymentOrExecuteAsync()
    {
        if (ActionsBlocked || !_targetingState.Refresh(CombatState.GameState, LocalPlayerId) || !_targetingState.IsComplete) return;
        var ability = _targetingState.ActiveAbility!;
        int neutralCost = ability.Costs.ContainsKey(EssenceType.Neutral) ? ability.Costs[EssenceType.Neutral] : 0;

        if (neutralCost > 0)
        {
            _neutralCostPending = neutralCost;

            if (LocalPlayerEssencePool is { } pool)
            {
                _availableEssenceForPayment = new Dictionary<EssenceType, int>(pool);

                foreach (var cost in ability.Costs.Where(c => c.Key != EssenceType.Neutral))
                {
                    _availableEssenceForPayment[cost.Key] = _availableEssenceForPayment.GetValueOrDefault(cost.Key) - cost.Value;
                }
            }
            else
            {
                CancelPreparedAction();
                _interactionFeedback = "Essence information is unavailable. Refresh combat before paying.";
                return;
            }

            _showPaymentModal = true;
            _interactionFeedback = $"Choose {neutralCost} essences for the neutral cost. No command has been sent.";
        }
        else
        {
            var finalPayment = ability.Costs.ToDictionary(k => k.Key, v => v.Value);
            await ExecuteAbilityAsync(finalPayment);
        }
    }

    private void CancelPayment()
    {
        CancelTargeting();
    }

    private async Task ProcessManualPaymentAndExecute(List<EssenceType> neutralPaymentChoices)
    {
        if (ActionsBlocked || !_showPaymentModal || _availableEssenceForPayment is null || neutralPaymentChoices.Count != _neutralCostPending ||
            neutralPaymentChoices.GroupBy(e => e).Any(g => _availableEssenceForPayment.GetValueOrDefault(g.Key) < g.Count())) return;
        if (_targetingState.ActiveAbility is not { } ability) return;

        var finalPayment = ability.Costs
            .Where(c => c.Key != EssenceType.Neutral)
            .ToDictionary(k => k.Key, v => v.Value);

        foreach (var choice in neutralPaymentChoices)
        {
            if (!finalPayment.ContainsKey(choice)) finalPayment[choice] = 0;
            finalPayment[choice]++;
        }

        await ExecuteAbilityAsync(finalPayment);
    }

    private async Task ExecuteAbilityAsync(Dictionary<EssenceType, int> payment)
    {
        if (ActionsBlocked || !_targetingState.Refresh(CombatState.GameState, LocalPlayerId) || !_targetingState.IsComplete) return;
        _interactionFeedback = null;
        _submittingPreparedAction = true;
        try
        {
            var targetSelections = _targetingState.SelectedTargets.ToDictionary(
                entry => entry.Key,
                entry => new List<int>(entry.Value));

            await CombatState.ExecuteAbilityAsync(
                _targetingState.SourceId!.Value,
                _targetingState.ActiveAbility!.Id,
                targetSelections,
                payment);
        }

        finally
        {
            CancelPreparedAction();
            _submittingPreparedAction = false;
        }
    }

    private async Task ExecuteExchangeAsync((Dictionary<EssenceType, int> Spent, EssenceType Gained) payload)
    {
        if (ActionsBlocked || !IsLocalPlayerTurn || !_showExchangeModal) return;
        _interactionFeedback = null;
        _submittingPreparedAction = true;
        try
        {
            await CombatState.ExchangeEssenceAsync(payload.Spent, payload.Gained);
        }
        finally
        {
            _submittingPreparedAction = false;
            _showExchangeModal = false;
        }
    }

    private void OpenExchange()
    {
        if (ActionsBlocked || !IsLocalPlayerTurn || _showPaymentModal || _targetingState.IsActive) return;
        _interactionFeedback = null;
        _showExchangeModal = true;
    }

    private async Task LeaveArena()
    {
        if (CombatState.IsCommandPending || _leavingArena) return;
        _leavingArena = true;
        var destination = CombatState.MatchType == MatchType.Dungeon ? "/dungeons" : "/encounters";
        await CombatState.DisconnectAsync();
        NavManager.NavigateTo(destination);
    }
}
