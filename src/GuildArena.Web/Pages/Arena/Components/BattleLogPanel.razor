@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="battle-logs-panel" aria-label="Battle log">
    @if (ShowHeading)
    {
        <header class="log-heading">
            <h2>Battle log</h2>
            @HeadingAction
        </header>
    }
    <div id="@ContainerId" class="log-scroll" @ref="_scroll" tabindex="0" aria-label="Battle log entries">
        @if (Logs.Count == 0)
        {
            <p class="empty-log">No battle messages yet.</p>
        }
        else
        {
            <ol class="log-list">
                @for (var i = 0; i < Logs.Count; i++)
                {
                    <li><span class="entry-number" aria-hidden="true">@((i + 1).ToString("D2"))</span><span>@Logs[i]</span></li>
                }
            </ol>
        }
    </div>
    <div class="log-updates" @ref="_updates" hidden>
        <span role="status" aria-live="polite" aria-atomic="true"></span>
        <button type="button">Show latest</button>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<string> Logs { get; set; }
    [Parameter] public string ContainerId { get; set; } = "battle-logs-container";
    [Parameter] public bool ShowHeading { get; set; } = true;
    [Parameter] public RenderFragment? HeadingAction { get; set; }

    private ElementReference _scroll;
    private ElementReference _updates;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Arena/Components/BattleLogPanel.razor.js");
        await _module.InvokeVoidAsync("update", _scroll, _updates, Logs.Count);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose", _scroll);
            await _module.DisposeAsync();
        }
    }
}
