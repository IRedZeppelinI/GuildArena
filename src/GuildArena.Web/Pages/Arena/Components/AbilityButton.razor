@using GuildArena.Shared.DTOs.Combat
@using GuildArena.Web.Services
@inject IAssetService AssetService

<button type="button" class="ability-slot @(ShowName ? "named-ability" : "") @(IsOnCooldown ? "on-cooldown" : "") @(!Ability.IsAffordable ? "unaffordable" : "")"
     aria-label="@(InspectionOnly ? $"Inspect {Ability.Name}" : $"{Ability.Name}{(!CanCast ? $", {AvailabilityReason}" : "")}")" aria-disabled="@(!InspectionOnly && !CanCast ? "true" : "false")"
     @onclick="OnClick"
     @onclick:stopPropagation="true"
     @onmouseenter="OnMouseEnter"
     @onfocus="OnMouseEnter"
     title="@(InspectionOnly || CanCast ? Ability.Name : $"{Ability.Name}: {AvailabilityReason}")">

    <span class="ability-icon" style="background-image: url('@AssetService.GetAbilityIconUrl(Ability.Id)');"></span>
    @if (ShowName)
    {
        <span class="ability-name">@Ability.Name</span>
    }

    @if (IsOnCooldown)
    {
        <span class="cooldown-overlay">
            <span>@Ability.CurrentCooldownTurns</span>
        </span>
    }

    @if (Ability.Costs.Any())
    {
        <span class="ability-costs">
            @foreach (var cost in Ability.Costs.Where(c => c.Value > 0))
            {
                @for (int i = 0; i < cost.Value; i++)
                {
                    <span class="mini-essence"
                         style="background-image: url('@AssetService.GetEssenceIconUrl(cost.Key.ToString())');"
                         title="@cost.Key">
                    </span>
                }
            }
        </span>
    }
</button>

@code {
    [Parameter, EditorRequired]
    public required AbilitySummaryDto Ability { get; set; }

    [Parameter] public EventCallback<string> OnAbilityClicked { get; set; }
    [Parameter] public EventCallback<AbilitySummaryDto> OnInspectStart { get; set; }
    [Parameter] public EventCallback<AbilitySummaryDto> OnInspectRequested { get; set; }
    [Parameter] public bool ShowName { get; set; }
    [Parameter] public bool InspectionOnly { get; set; }
    [Parameter] public bool IsActivationBlocked { get; set; }

    private bool IsOnCooldown => Ability.CurrentCooldownTurns > 0;
    private bool CanCast => !IsActivationBlocked && !IsOnCooldown && Ability.IsAffordable;
    private string AvailabilityReason => IsOnCooldown ? $"cooldown: {Ability.CurrentCooldownTurns} turns"
        : !Ability.IsAffordable ? "unavailable with the current resources or combat restrictions"
        : "activation paused; review the current turn or pending action";

    private async Task OnClick()
    {
        if (InspectionOnly)
            await OnInspectRequested.InvokeAsync(Ability);
        else if (CanCast)
        {
            await OnAbilityClicked.InvokeAsync(Ability.Id);
        }
    }

    private async Task OnMouseEnter()
    {
        await OnInspectStart.InvokeAsync(Ability);
    }
    
}
