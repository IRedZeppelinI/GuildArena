@using GuildArena.Domain.Enums.Resources

<CombatDialog Title="Exchange essence" CssClass="exchange-dialog" ReturnFocusSelector=".exchange-btn" IsPending="IsPending" OnDismiss="Cancel">
    <ChildContent>
        <p class="dialog-copy">Choose two essences to spend and one essence to receive. The server confirms the exchange.</p>
        <div class="exchange-columns">
            <section aria-label="Essences to spend">
                <h3>Spend two essences</h3>
                <EssenceChoices Types="PlayerEssencePool.Where(e => e.Value > 0).Select(e => e.Key)" Pool="PlayerEssencePool"
                                Selection="_spentList" Limit="2" IsPending="IsPending" OnSelect="SelectToSpend" />
                <div class="exchange-selection" role="status">
                    <p><strong>Selected: @_spentList.Count / 2</strong><br />@(_spentList.Count > 0 ? string.Join(", ", _spentList) : "No essences selected")</p>
                    <button type="button" class="dialog-button" disabled="@(IsPending || _spentList.Count == 0)" @onclick="ResetSelection">Clear</button>
                </div>
            </section>
            <section aria-label="Essence to receive">
                <h3>Receive one essence</h3>
                <EssenceChoices Types="_allEssenceTypes" Selection="GainedSelection" IsPending="IsPending" OnSelect="SelectGain" />
            </section>
        </div>
        <p class="dialog-feedback" role="status">@Feedback</p>
    </ChildContent>
    <Actions>
        <button type="button" class="dialog-button" disabled="@IsPending" @onclick="Cancel" autofocus>Cancel</button>
        <button type="button" class="dialog-button dialog-primary" disabled="@(IsPending || !CanConfirm)" @onclick="Confirm">@(IsPending ? "Processing…" : "Transmute")</button>
    </Actions>
</CombatDialog>

@code {
    [Parameter] public bool IsPending { get; set; }
    [Parameter] public string? Feedback { get; set; }
    [Parameter, EditorRequired] public required Dictionary<EssenceType, int> PlayerEssencePool { get; set; }
    [Parameter] public EventCallback<(Dictionary<EssenceType, int> Spent, EssenceType Gained)> OnConfirmExchange { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly List<EssenceType> _spentList = [];
    private EssenceType? _gainedType;
    private IReadOnlyCollection<EssenceType> GainedSelection => _gainedType is { } type ? [type] : [];
    private readonly EssenceType[] _allEssenceTypes = [EssenceType.Vigor, EssenceType.Mind, EssenceType.Light, EssenceType.Shadow, EssenceType.Flux];
    private bool CanConfirm => _spentList.Count == 2 && _gainedType != null;

    private void SelectToSpend(EssenceType type)
    {
        if (!IsPending && _spentList.Count < 2 && _spentList.Count(e => e == type) < PlayerEssencePool.GetValueOrDefault(type)) _spentList.Add(type);
    }

    private void SelectGain(EssenceType type)
    {
        if (!IsPending) _gainedType = type;
    }

    private void ResetSelection()
    {
        if (!IsPending) _spentList.Clear();
    }

    private async Task Confirm()
    {
        if (IsPending || !CanConfirm) return;
        var spent = _spentList.GroupBy(e => e).ToDictionary(g => g.Key, g => g.Count());
        await OnConfirmExchange.InvokeAsync((spent, _gainedType!.Value));
    }

    private async Task Cancel()
    {
        if (!IsPending) await OnCancel.InvokeAsync();
    }
}
