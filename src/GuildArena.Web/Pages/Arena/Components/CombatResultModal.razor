@using GuildArena.Shared.DTOs.Combat

<CombatDialog @ref="_dialog" Title="Battle complete" CssClass="result-dialog" CanDismiss="false" IsPending="IsPending">
    <ChildContent>
        <div class="result-summary @(Result.IsWinner ? "victory" : "defeat")">
            <img class="result-brand" src="/images/ui/estandarte.svg" width="38" height="44" alt="" />
            <h1 class="result-title" tabindex="-1" autofocus>@(Result.IsSurrender ? "Surrendered" : Result.IsWinner ? "Victory" : "Defeat")</h1>
            <p>@(Result.IsWinner ? "The battle is won." : "This battle counts as a defeat.")
                @if (ReturnToDungeon && !Result.IsWinner) { <span>Your expedition has ended.</span> }
            </p>
        </div>
        <div class="result-rewards" aria-label="Confirmed rewards">
            <div><strong><img src="/images/ui/gold.svg" width="22" height="22" alt="" /><span class="reward-amount">@Result.GoldGained</span></strong><span>Gold gained</span></div>
            <div><strong><span class="reward-amount">@Result.XpGained XP</span></strong><span>Guild experience</span></div>
        </div>
        @if (Result.NewGuildLevel > 0)
        {
            <p class="result-level">Guild level <strong>@Result.NewGuildLevel</strong></p>
        }
        @if (IsPending)
        {
            <p class="dialog-feedback" role="status">Finishing the pending request. Please wait before returning.</p>
        }
    </ChildContent>
    <Actions>
        <button type="button" class="dialog-button dialog-primary return-btn" disabled="@IsPending" @onclick="OnReturnClicked">
            @(IsPending ? "Finishing…" : ReturnToDungeon ? "Return to Dungeons" : "Return to Encounters")
        </button>
    </Actions>
</CombatDialog>

@code {
    private CombatDialog? _dialog;
    public ValueTask FocusAsync() => _dialog?.FocusAsync() ?? ValueTask.CompletedTask;
    [Parameter] public bool IsPending { get; set; }
    [Parameter, EditorRequired] public required CombatResultDto Result { get; set; }
    [Parameter] public bool ReturnToDungeon { get; set; }
    [Parameter] public EventCallback OnReturnClicked { get; set; }
}
