@using GuildArena.Shared.DTOs.Combat
@inject IJSRuntime JS
@implements IAsyncDisposable

<footer class="arena-footer">
    <section class="desktop-inspection" aria-label="Inspection panel">
        <CombatInspection Ability="InspectedAbility" Combatant="InspectedCombatant">
            <HeadingAction>
                <button type="button" class="expand-inspection" @onclick="ShowInspectionAsync" aria-label="Expand combat details" title="Expand combat details">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 16 19 5M10 5h9v9M5 9v10h10" /></svg>
                </button>
            </HeadingAction>
        </CombatInspection>
    </section>
    <div class="desktop-logs-wrapper">
        <BattleLogPanel Logs="BattleLogs.ToList()" ContainerId="desktop-logs-container" />
    </div>
    <section class="mobile-command-deck" aria-label="Selected hero actions">
        <header class="deck-heading">
            <h2 title="@SelectedCombatant?.Name">@(SelectedCombatant?.Name ?? "Select a hero")</h2>
            @if (SelectedCombatant is { IsAlive: false }) { <span class="fallen-label">Fallen</span> }
            <button type="button" class="utility-button inspection-mode" aria-pressed="@(_inspectAbilities ? "true" : "false")" @onclick="() => _inspectAbilities = !_inspectAbilities">@(_inspectAbilities ? "Use abilities" : "Inspect abilities")</button>
            <button type="button" class="utility-button" @onclick="OnToggleMobileLogs">Battle log</button>
        </header>
        <div class="deck-abilities" aria-label="@(_inspectAbilities ? "Choose an ability to inspect" : "Choose an ability to activate")">
            @if (SelectedCombatant is { } hero)
            {
                @foreach (var ability in SelectedAbilities)
                {
                    <AbilityButton @key="(hero.Id, ability.Id)" Ability="ability" ShowName="true" InspectionOnly="_inspectAbilities"
                                   IsActivationBlocked="@(IsActivationBlocked || !IsLocalPlayerTurn || !hero.IsAlive)"
                                   OnAbilityClicked="ActivateSelectedAbility" OnInspectStart="OnInspectAbility" OnInspectRequested="OnInspectAbilityRequested" />
                }
            }
        </div>
    </section>
    <div class="footer-actions">
        <button type="button" class="utility-button inspect-selected" disabled="@(SelectedCombatant is null)" @onclick="OnInspectSelectedCombatant">Inspect hero</button>
        @if (IsLocalPlayerTurn)
        {
            <button class="end-turn-btn" @onclick="@(IsTargetingActive ? OnCancelTargeting : OnEndTurn)">
                @(IsTargetingActive ? "Cancel Action" : "End Turn")
            </button>
        }
        else
        {
            <button class="end-turn-btn" disabled>Enemy Turn</button>
        }
    </div>
</footer>

<dialog class="inspection-dialog" @ref="_inspectionDialog" aria-labelledby="inspection-dialog-title">
    <div class="dialog-layout">
        <header class="dialog-heading">
            <h2 id="inspection-dialog-title">@(_effectsOnly ? "Active effects" : "Combat details")</h2>
            <button class="utility-button" @onclick="CloseInspectionAsync" autofocus>Close</button>
        </header>
        <div class="dialog-inspection"><CombatInspection Ability="InspectedAbility" Combatant="InspectedCombatant" EffectsOnly="_effectsOnly" /></div>
    </div>
</dialog>

@code {
    [Parameter] public AbilitySummaryDto? InspectedAbility { get; set; }
    [Parameter] public CombatantDto? InspectedCombatant { get; set; }
    [Parameter] public CombatantDto? SelectedCombatant { get; set; }
    [Parameter] public bool IsActivationBlocked { get; set; }
    [Parameter] public EventCallback<(int SourceId, string AbilityId)> OnAbilityActivated { get; set; }
    [Parameter] public EventCallback<AbilitySummaryDto> OnInspectAbility { get; set; }
    [Parameter] public EventCallback<AbilitySummaryDto> OnInspectAbilityRequested { get; set; }
    [Parameter] public EventCallback OnInspectSelectedCombatant { get; set; }
    [Parameter] public IReadOnlyList<string> BattleLogs { get; set; } = Array.Empty<string>();
    [Parameter] public bool IsLocalPlayerTurn { get; set; }
    [Parameter] public bool IsTargetingActive { get; set; }
    [Parameter] public EventCallback OnToggleMobileLogs { get; set; }
    [Parameter] public EventCallback OnCancelTargeting { get; set; }
    [Parameter] public EventCallback OnEndTurn { get; set; }

    private ElementReference _inspectionDialog;
    private IJSObjectReference? _module;
    private bool _effectsOnly;
    private bool _inspectAbilities;

    private IEnumerable<AbilitySummaryDto> SelectedAbilities => SelectedCombatant is { } hero
        ? (hero.SpecialAbility is { } special ? new[] { special }.Concat(hero.Abilities) : hero.Abilities)
        : Array.Empty<AbilitySummaryDto>();

    private Task ActivateSelectedAbility(string abilityId) => SelectedCombatant is { } hero
        ? OnAbilityActivated.InvokeAsync((hero.Id, abilityId)) : Task.CompletedTask;

    public Task ShowInspectionAsync() => OpenInspectionAsync(false);
    public Task ShowEffectsAsync() => OpenInspectionAsync(true);

    private async Task OpenInspectionAsync(bool effectsOnly)
    {
        _effectsOnly = effectsOnly;
        StateHasChanged();
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Arena/Components/ArenaFooter.razor.js");
        await _module.InvokeVoidAsync("show", _inspectionDialog);
    }

    private async Task CloseInspectionAsync()
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("close", _inspectionDialog);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
            await _module.DisposeAsync();
    }
}
