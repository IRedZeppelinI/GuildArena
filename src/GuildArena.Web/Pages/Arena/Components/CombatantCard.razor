@using GuildArena.Shared.DTOs.Combat
@using GuildArena.Web.Services
@using GuildArena.Web.Components
@inject IAssetService AssetService

<article class="combatant-card @(Combatant.IsAlive ? "" : "dead") @(IsSelectedCombatant ? "selected-combatant" : "") @(IsTargetingMode ? "targeting-mode" : "") @(IsValidTarget ? "valid-target" : "") @(IsSelectedTarget ? "selected-target" : "")"
     aria-label="@Combatant.Name"
     @onclick="OnCardClicked">
    <div class="card-left" @onmouseenter="() => OnCombatantHovered.InvokeAsync(Combatant)">
        <button type="button" class="portrait-placeholder" style="background-image: url('@AssetService.GetPortraitUrl(Combatant.DefinitionId)');"
                aria-label="@CombatantActionLabel" aria-pressed="@(IsLocalCombatant && !IsTargetingMode ? (IsSelectedCombatant ? "true" : "false") : null)"
                aria-disabled="@(IsTargetingMode && !IsValidTarget ? "true" : "false")"
                @onfocus="() => OnCombatantHovered.InvokeAsync(Combatant)"
                @onclick="InspectCombatant" @onclick:stopPropagation="true">
        </button>
    </div>

    <div class="card-right">
        <div class="info-top" @onmouseenter="() => OnCombatantHovered.InvokeAsync(Combatant)">
            <div class="identity-row">
                <button class="name" type="button" @onclick="InspectCombatant" @onclick:stopPropagation="true"
                        aria-label="@CombatantActionLabel" title="@Combatant.Name"
                         aria-disabled="@(IsTargetingMode && !IsValidTarget ? "true" : "false")">@Combatant.Name</button>
                <span class="action-points" aria-label="@($"{RemainingActionPoints} of {Combatant.MaxActions} action points remaining")" title="Remaining / maximum AP">
                    <ResourceIcon Kind="ResourceIconKind.ActionPoints" /> @RemainingActionPoints/@Combatant.MaxActions
                </span>
            </div>
            <div class="hp-container" aria-label="@($"Health: {Combatant.CurrentHP} / {Combatant.MaxHP}")">
                <div class="hp-fill" style="width: @(HpPercentage)%"></div>
                <span class="hp-text">@Combatant.CurrentHP / @Combatant.MaxHP</span>
            </div>
        </div>

        <div class="abilities-zone">
            @foreach (var ability in AllAbilities)
            {
                <AbilityButton Ability="ability"
                               IsActivationBlocked="@(IsActivationBlocked || !IsLocalCombatant || !Combatant.IsAlive)"
                               InspectionOnly="@(!IsLocalCombatant)"
                               OnInspectRequested="OnInspectAbility"
                               OnAbilityClicked="HandleAbilityClick"
                               OnInspectStart="OnInspectAbility" />
            }
        </div>
    </div>
    @if (Combatant.ActiveModifiers.Count > 0)
    {
        <div class="modifiers-zone" aria-label="Active effects">
            @foreach (var modifier in ModifierPresentation.Order(Combatant.ActiveModifiers).Take(2))
            {
                <button type="button" class="modifier-label @(ModifierPresentation.IsRestriction(modifier) ? "restriction" : modifier.TurnsRemaining == -1 ? "permanent" : "")"
                        aria-label="@($"{ModifierPresentation.Name(modifier)}, {ModifierPresentation.Duration(modifier.TurnsRemaining)}. View all effects on {Combatant.Name}")"
                        @onclick="InspectEffects" @onclick:stopPropagation="true">
                    <span class="modifier-name">@ModifierPresentation.Name(modifier)</span>
                    <span class="modifier-duration" aria-hidden="true">@ModifierPresentation.CompactDuration(modifier.TurnsRemaining)</span>
                </button>
            }
            @if (Combatant.ActiveModifiers.Count > 2)
            {
                <button type="button" class="more-effects" aria-label="@($"View all {Combatant.ActiveModifiers.Count} effects on {Combatant.Name}")"
                        @onclick="InspectEffects" @onclick:stopPropagation="true">+@(Combatant.ActiveModifiers.Count - 2)</button>
            }
        </div>
    }
    <button type="button" class="mobile-inspect" aria-label="@($"Inspect {Combatant.Name}. Health: {Combatant.CurrentHP} of {Combatant.MaxHP}. {RemainingActionPoints} of {Combatant.MaxActions} AP remaining. {Combatant.ActiveModifiers.Count} active effects. View attributes and abilities.")"
            @onclick="() => OnInspectCombatantRequested.InvokeAsync(Combatant)" @onclick:stopPropagation="true">
        <span class="identity-row">
            <span class="name">@Combatant.Name</span>
            <span class="action-points" aria-label="@($"{RemainingActionPoints} of {Combatant.MaxActions} action points remaining")">
                <ResourceIcon Kind="ResourceIconKind.ActionPoints" /> @RemainingActionPoints/@Combatant.MaxActions
            </span>
        </span>
        <span class="hp-container" aria-label="@($"Health: {Combatant.CurrentHP} / {Combatant.MaxHP}")">
            <span class="hp-fill" style="width: @(HpPercentage)%"></span>
            <span class="hp-text">@Combatant.CurrentHP / @Combatant.MaxHP</span>
        </span>
        @if (Combatant.ActiveModifiers.Count > 0)
        {
            <span class="mobile-modifiers" aria-label="Active effects">
                @foreach (var modifier in ModifierPresentation.Order(Combatant.ActiveModifiers).Take(2))
                {
                    <span class="modifier-label @(ModifierPresentation.IsRestriction(modifier) ? "restriction" : modifier.TurnsRemaining == -1 ? "permanent" : "")">
                        <span class="modifier-name">@ModifierPresentation.Name(modifier)</span>
                        <span class="modifier-duration">@ModifierPresentation.CompactDuration(modifier.TurnsRemaining)</span>
                    </span>
                }
                @if (Combatant.ActiveModifiers.Count > 2)
                {
                    <span class="more-effects">+@(Combatant.ActiveModifiers.Count - 2)</span>
                }
            </span>
        }
    </button>
    @if (!Combatant.IsAlive || IsTargetingMode)
    {
        <div class="card-state">
            @if (!Combatant.IsAlive) { <span>Fallen</span> }
            @if (IsTargetingMode)
            {
                <span class="desktop-target-state">@(IsSelectedTarget ? "Target selected" : IsValidTarget ? "Select target" : "Not a valid target")</span>
                <span class="mobile-target-state">@(IsSelectedTarget ? "Selected" : IsValidTarget ? "Target" : "Unavailable")</span>
            }
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public required CombatantDto Combatant { get; set; }

    [Parameter]
    public bool IsTargetingMode { get; set; } = false;
    [Parameter] public bool IsActivationBlocked { get; set; }

    [Parameter]
    public bool IsValidTarget { get; set; } = false;

    [Parameter]
    public bool IsSelectedTarget { get; set; } = false;

    [Parameter] public bool IsSelectedCombatant { get; set; }
    [Parameter] public bool IsLocalCombatant { get; set; }
    [Parameter] public EventCallback<CombatantDto> OnCombatantSelected { get; set; }

    private string CombatantActionLabel => IsTargetingMode ? $"Select {Combatant.Name} as target"
        : IsLocalCombatant ? $"Select {Combatant.Name} for actions" : $"Inspect {Combatant.Name}";

    [Parameter]
    public EventCallback<CombatantDto> OnCombatantClicked { get; set; }

    [Parameter]
    public EventCallback<(int SourceId, string AbilityId)> OnAbilityActivated { get; set; }

    [Parameter]
    public EventCallback<AbilitySummaryDto> OnInspectAbility { get; set; }

    [Parameter]
    public EventCallback<CombatantDto?> OnCombatantHovered { get; set; }

    [Parameter]
    public EventCallback<CombatantDto> OnInspectCombatantRequested { get; set; }

    [Parameter] public EventCallback<CombatantDto> OnInspectEffectsRequested { get; set; }

    private int HpPercentage => Combatant.MaxHP == 0 ? 0 : (int)Math.Clamp(((double)Combatant.CurrentHP / Combatant.MaxHP) * 100, 0, 100);

    private int RemainingActionPoints => Math.Max(0, Combatant.MaxActions - Combatant.ActionsTakenThisTurn);

    private IEnumerable<AbilitySummaryDto> AllAbilities
    {
        get
        {
            if (Combatant.SpecialAbility != null) yield return Combatant.SpecialAbility;
            foreach (var ab in Combatant.Abilities) yield return ab;
        }
    }

    private async Task OnCardClicked()
    {
        if (IsTargetingMode && IsValidTarget && !IsSelectedTarget)
        {
            await OnCombatantClicked.InvokeAsync(Combatant);
        }
        else if (!IsTargetingMode)
        {
            if (IsLocalCombatant)
                await OnCombatantSelected.InvokeAsync(Combatant);
            else
                await OnCombatantHovered.InvokeAsync(Combatant);
        }
    }

    private Task InspectCombatant() => IsTargetingMode
        ? OnCardClicked()
        : IsLocalCombatant ? OnCombatantSelected.InvokeAsync(Combatant)
        : OnInspectCombatantRequested.InvokeAsync(Combatant);

    private Task InspectEffects() => OnInspectEffectsRequested.InvokeAsync(Combatant);

    private async Task HandleAbilityClick(string abilityId)
    {
        await OnAbilityActivated.InvokeAsync((Combatant.Id, abilityId));
    }
}
