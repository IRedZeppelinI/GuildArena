@using GuildArena.Domain.Enums.Resources

<CombatDialog Title="Pay neutral cost" CssClass="payment-dialog" IsPending="IsPending" OnDismiss="Cancel">
    <ChildContent>
        <p class="dialog-copy">Select @RequiredAmount essences to pay the remaining neutral cost. Mandatory colored costs are already reserved.</p>
        <EssenceChoices Types="AvailableEssence.Where(e => e.Value > 0).Select(e => e.Key)" Pool="AvailableEssence"
                        Selection="_selectedToPay" Limit="RequiredAmount" IsPending="IsPending" OnSelect="SelectEssence" />
        <div class="payment-summary" role="status">
            <p><strong>Selected essences</strong><span>@(_selectedToPay.Count > 0 ? string.Join(", ", _selectedToPay) : "No essences selected")</span></p>
            <button type="button" class="dialog-button" disabled="@(IsPending || _selectedToPay.Count == 0)" @onclick="ResetSelection">Clear</button>
        </div>
        <p class="dialog-feedback" role="status">@Feedback</p>
    </ChildContent>
    <Actions>
        <span class="dialog-progress payment-progress" role="status">Allocated: <strong>@_selectedToPay.Count / @RequiredAmount</strong></span>
        <button type="button" class="dialog-button" disabled="@IsPending" @onclick="Cancel" autofocus>Cancel</button>
        <button type="button" class="dialog-button dialog-primary" disabled="@(IsPending || !CanConfirm)" @onclick="Confirm">@(IsPending ? "Processing…" : "Pay & Execute")</button>
    </Actions>
</CombatDialog>

@code {
    [Parameter] public bool IsPending { get; set; }
    [Parameter] public string? Feedback { get; set; }
    // Already excludes the mandatory colored costs; supplied by the prepared action.
    [Parameter, EditorRequired] public required Dictionary<EssenceType, int> AvailableEssence { get; set; }
    [Parameter, EditorRequired] public int RequiredAmount { get; set; }
    [Parameter] public EventCallback<List<EssenceType>> OnConfirmPayment { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly List<EssenceType> _selectedToPay = [];
    private bool CanConfirm => _selectedToPay.Count == RequiredAmount;

    private void SelectEssence(EssenceType type)
    {
        if (!IsPending && _selectedToPay.Count < RequiredAmount && _selectedToPay.Count(e => e == type) < AvailableEssence.GetValueOrDefault(type)) _selectedToPay.Add(type);
    }

    private void ResetSelection()
    {
        if (!IsPending) _selectedToPay.Clear();
    }

    private async Task Confirm()
    {
        if (CanConfirm && !IsPending) await OnConfirmPayment.InvokeAsync(new List<EssenceType>(_selectedToPay));
    }

    private async Task Cancel()
    {
        if (!IsPending) await OnCancel.InvokeAsync();
    }
}
