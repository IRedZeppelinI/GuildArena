@page "/forgot-password"
@using GuildArena.Shared.Requests
@inject HttpClient Http

<PageTitle>Recover access | GuildArena</PageTitle>

<div class="auth-page">
    <header class="auth-intro">
        <p class="auth-eyebrow">Account recovery</p>
        <h1>Recover access</h1>
        <p>Enter your account email to request a password reset link.</p>
    </header>
    <section class="auth-card" aria-label="Request password reset">
        @if (_isSubmitted)
        {
            <div class="auth-feedback success" role="status">
                <h2>Request received</h2>
                <p>If an account matches that email address and is confirmed, a reset link will be sent. Check your inbox.</p>
            </div>
            <a href="/login" class="auth-action auth-wide">Return to sign in</a>
        }
        else
        {
            <form @onsubmit="SubmitRequestAsync" @onsubmit:preventDefault="true">
                @if (_errorMessage is not null)
                {
                    <div class="auth-feedback error" role="alert">@_errorMessage</div>
                }
                <div class="auth-field">
                    <label for="recovery-email">Account email</label>
                    <input id="recovery-email" name="email" type="email" autocomplete="email" @bind="_email" required disabled="@_isLoading" />
                </div>
                <button type="submit" class="auth-action auth-wide" disabled="@_isLoading">@(_isLoading ? "Sending request..." : "Request reset link")</button>
                @if (_isLoading)
                {
                    <p class="auth-hint" role="status">Submitting your request...</p>
                }
            </form>
            <div class="auth-footer"><a href="/login">Return to sign in</a></div>
        }
    </section>
</div>

@code {
    private string _email = string.Empty;
    private bool _isLoading;
    private bool _isSubmitted;
    private string? _errorMessage;

    private async Task SubmitRequestAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var request = new ForgotPasswordRequest { Email = _email };
            await Http.PostAsJsonAsync("forgotPassword", request);
            // The endpoint deliberately gives no indication whether an account exists.
            _isSubmitted = true;
        }
        catch
        {
            _errorMessage = "Connection unavailable. Please try again later.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
