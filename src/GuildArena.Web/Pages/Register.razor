@page "/register"
@using GuildArena.Shared.Requests
@inject HttpClient Http

<PageTitle>Create account | GuildArena</PageTitle>

<div class="auth-page">
    <header class="auth-intro">
        <p class="auth-eyebrow">Begin your journey</p>
        <h1>Create an account</h1>
        <p>Register with your email address, then confirm it to access your guild.</p>
    </header>
    <section class="auth-card" aria-label="Registration">
        @if (_registrationSuccessful)
        {
            <div class="auth-feedback success" role="status">
                <h2>Check your inbox</h2>
                <p>Your account was created. Follow the confirmation link sent to your email before signing in.</p>
            </div>
            <a href="/login" class="auth-action auth-wide">Go to sign in</a>
        }
        else
        {
            <form @onsubmit="ExecuteRegister" @onsubmit:preventDefault="true">
                @if (_errorMessage is not null)
                {
                    <div class="auth-feedback error" role="alert">@_errorMessage</div>
                }
                <div class="auth-field">
                    <label for="register-email">Email address</label>
                    <input id="register-email" name="email" type="email" autocomplete="email" @bind="_request.Email" required disabled="@_isLoading" />
                </div>
                <div class="auth-field">
                    <label for="register-password">Password</label>
                    <input id="register-password" name="password" type="password" autocomplete="new-password" @bind="_request.Password" required aria-describedby="register-password-help" disabled="@_isLoading" />
                    <p id="register-password-help" class="auth-hint">Choose a strong, unique password. Password requirements are checked when you submit.</p>
                </div>
                <button type="submit" class="auth-action auth-wide" disabled="@_isLoading">@(_isLoading ? "Creating account..." : "Create account")</button>
                @if (_isLoading)
                {
                    <p class="auth-hint" role="status">Submitting your registration...</p>
                }
            </form>
            <div class="auth-footer">Already registered? <a href="/login">Sign in</a></div>
        }
    </section>
</div>

@code {
    private LoginRequest _request = new() { Email = string.Empty, Password = string.Empty };
    private string? _errorMessage;
    private bool _isLoading;
    private bool _registrationSuccessful;

    private async Task ExecuteRegister()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var response = await Http.PostAsJsonAsync("register", _request);
            if (response.IsSuccessStatusCode)
            {
                _registrationSuccessful = true;
            }
            else
            {
                _errorMessage = "Registration could not be completed. Check the password requirements or try signing in if you already have an account. If you received a confirmation email, follow its link.";
            }
        }
        catch
        {
            _errorMessage = "Connection unavailable. Your request may have been received; check your inbox before trying again.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
