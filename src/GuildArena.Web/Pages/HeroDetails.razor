@page "/hero/{DefinitionId}"
@attribute [Authorize]
@using GuildArena.Shared.DTOs.GuildAndHeroes
@using GuildArena.Shared.DTOs.Combat
@using GuildArena.Shared.DTOs.Shop
@using GuildArena.Shared.Requests
@using GuildArena.Domain.Enums.Stats
@using GuildArena.Domain.Enums.Combat
@using GuildArena.Domain.Enums.UnlockHero
@using GuildArena.Web.Services
@inject HttpClient Http
@inject IAssetService AssetService
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>Hero Details</PageTitle>

<div class="container mt-4 text-light pb-5">

    <button class="btn btn-outline-secondary mb-4" @onclick="GoBack">
        ← Back
    </button>

    @if (_errorMessage != null)
    {
        <div class="alert alert-danger mt-3 shadow-sm border-danger">
            <h5 class="text-danger fw-bold">Error loading hero</h5><p class="mb-0">@_errorMessage</p>
        </div>
    }
    else if (_hero == null || _tavernInfo == null)
    {
        <div class="text-center mt-5"><p><em>Loading Hero Records...</em></p></div>
    }
    else
    {
        <!-- BLOCO SUPERIOR: Retrato + Loja (Esq) | Stats + Traits (Dir) -->
        <div class="row mb-5">

            <!-- COLUNA ESQUERDA: Retrato e Widget da Taverna -->
            <div class="col-lg-3 col-md-4 mb-4 mb-md-0">
                <div class="card bg-dark border-secondary shadow-lg hero-portrait-card">
                    <img src="@AssetService.GetPortraitUrl(_hero.DefinitionId)" class="card-img-top hero-details-img" alt="@_hero.Name" />
                    <div class="card-body text-center p-3 border-bottom border-secondary">
                        <h3 class="card-title text-warning fw-bold mb-0">@_hero.Name</h3>
                        <p class="text-info small mb-2">@_hero.RaceName</p>
                        
                        <!-- HP e AP -->
                        <div class="d-flex justify-content-center gap-2 mt-2">
                            <span class="badge bg-danger fs-6 border border-secondary" title="Max Health Points">❤️ @_hero.MaxHP</span>
                            <span class="badge bg-warning text-dark fs-6 border border-secondary" title="Action Points">⚡ @_hero.MaxActions</span>
                        </div>
                    </div>
                </div>

                <!-- WIDGET DA TAVERNA -->
                <div class="card bg-dark border-secondary shadow-lg mt-3 tavern-widget">
                    <div class="card-body p-3 text-center">
                        <h5 class="text-warning border-bottom border-secondary pb-2 mb-3">Recruitment</h5>

                        @if (_purchaseSuccess != null)
                        {
                            <div class="alert alert-success small p-2 mb-3 border-success">@_purchaseSuccess</div>
                        }
                        @if (_purchaseError != null)
                        {
                            <div class="alert alert-danger small p-2 mb-3 border-danger">@_purchaseError</div>
                        }

                        @if (_tavernInfo.Status == HeroStatus.Owned)
                        {
                            <div class="badge bg-success fs-6 py-2 px-3 w-100 border border-light shadow-sm">
                                ✅ In Roster
                            </div>
                        }
                        else
                        {
                            @if (_tavernInfo.Status == HeroStatus.Locked)
                            {
                                <div class="conditions-box text-start bg-black p-2 rounded border border-secondary mb-3">
                                    <p class="text-danger small fw-bold mb-1 border-bottom border-dark pb-1">Requirements:</p>
                                    @foreach (var cond in _tavernInfo.UnlockConditions)
                                    {
                                        var isMet = cond.CurrentValue >= cond.RequiredValue;
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between small">
                                                <span class="@(isMet ? "text-success" : "text-light")" style="font-size: 0.7rem;">@cond.Description</span>
                                                <span class="@(isMet ? "text-success" : "text-warning") fw-bold" style="font-size: 0.7rem;">
                                                    @(Math.Min(cond.CurrentValue, cond.RequiredValue)) / @cond.RequiredValue
                                                </span>
                                            </div>
                                            <div class="progress" style="height: 4px; background-color: #333;">
                                                <div class="progress-bar @(isMet ? "bg-success" : "bg-warning")"
                                                     role="progressbar"
                                                     style="width: @((Math.Min(cond.CurrentValue, cond.RequiredValue) * 100) / cond.RequiredValue)%">
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <button class="btn btn-secondary w-100 fw-bold" disabled>
                                    <span class="fs-6">🔒 @_tavernInfo.GoldCost 🪙</span>
                                </button>
                            }
                            else if (_tavernInfo.Status == HeroStatus.Available)
                            {
                                <button class="btn btn-warning w-100 fw-bold d-flex justify-content-between align-items-center px-3"
                                        disabled="@_isPurchasing"
                                        @onclick="PurchaseHeroAsync">
                                    @if (_isPurchasing)
                                    {
                                        <span>Signing...</span>
                                    }
                                    else
                                    {
                                        <span>Recruit</span>
                                        <span>@_tavernInfo.GoldCost 🪙</span>
                                    }
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- COLUNA DIREITA: Stats no topo, Traits a preencher o espaço -->
            <div class="col-lg-9 col-md-8 d-flex flex-column">

                <!-- PARTE DE CIMA: STATS -->
                @* <div>
                    <h4 class="text-warning border-bottom border-secondary pb-2 mb-4">Combat Attributes</h4>
                    <div class="row text-center justify-content-center mb-4">
                        @StatBox("⚔️", "Attack", _hero.Attack, "text-light")
                        @StatBox("🛡️", "Defense", _hero.Defense, "text-secondary")
                        @StatBox("💨", "Agility", _hero.Agility, "text-success")
                        @StatBox("🔮", "Magic", _hero.Magic, "text-info")
                        @StatBox("🧿", "Magic Def", _hero.MagicDefense, "text-primary")
                    </div>
                </div> *@
                <!-- PARTE DE CIMA: STATS -->
                <div>
                    <h4 class="text-warning border-bottom border-secondary pb-2 mb-4">Combat Attributes</h4>
                    <div class="row text-center justify-content-center mb-4">
                        <!-- Attack: Vermelho (text-danger) -->
                        @StatBox(@<svg class="stat-icon-large text-danger" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M0 0h512v512H0z" fill="none"></path><g transform="translate(0,0)"><path d="m491.844 22.533-83.42 14.865L196.572 249.25c3.262 4.815 5.37 10.72 5.37 16.932 0 5.863-1.71 11.35-4.643 15.996a52.936 52.936 0 0 0-16.027-2.477c-15.724 0-29.904 6.89-39.69 17.796l-9.112-9.113 17.237-17.237a545.915 545.915 0 0 1-13.19-17.6l-19.443 19.44-13.215-13.215 21.828-21.827a548.134 548.134 0 0 1-12.792-20.068L72.093 258.68l58.314 58.314a52.94 52.94 0 0 0-2.49 16.063 52.86 52.86 0 0 0 4.592 21.564l-72.14 72.14-14.56-14.56L21.013 437l14.558 14.56-8.607 8.608 27.246 27.246 8.606-8.61 14.56 14.56 24.798-24.8-14.557-14.556 72.158-72.16a52.885 52.885 0 0 0 21.498 4.562 52.94 52.94 0 0 0 16.063-2.49l58.363 58.363L296.5 401.48a548.745 548.745 0 0 1-20.068-12.793l-21.83 21.83L241.39 397.3l19.442-19.44a550.258 550.258 0 0 1-17.603-13.194l-17.238 17.238-9.16-9.16c10.905-9.785 17.795-23.965 17.795-39.69 0-5.346-.806-10.51-2.285-15.39 4.703-3.04 10.288-4.817 16.265-4.816 6.21 0 11.776 1.77 16.52 4.955L476.98 105.95l14.864-83.417zm-66.227 53.012 13.215 13.215-191.684 191.68-13.214-13.213L425.617 75.545zM181.273 298.39c19.257 0 34.665 15.41 34.665 34.665 0 19.256-15.408 34.666-34.665 34.666-19.256 0-34.666-15.41-34.666-34.665s15.41-34.666 34.666-34.666z" fill="currentColor"></path></g></svg>, "Attack", _hero.Attack, "text-warning")
    
                        <!-- Defense: Ícone Vermelho (text-danger), Número Amarelo (text-warning) -->
                        @StatBox(@<svg class="stat-icon-large text-danger" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M0 0h512v512H0z" fill="none"></path><g transform="translate(0,0)"><path d="M261.563 64.28A191.758 191.758 0 0 0 64.25 256a191.758 191.758 0 1 0 383.5 0A191.758 191.758 0 0 0 261.562 64.28zm-4.625 9.126 8.937 5.156v10.313l-8.938 5.156-8.906-5.155V78.562l8.907-5.156zm3.53 29.25A153.407 153.407 0 0 1 409.407 256a153.407 153.407 0 0 1-306.812 0A153.407 153.407 0 0 1 260.47 102.656zm-11.53 20.03a133.607 133.607 0 0 0-65.157 20.908V368.22a133.607 133.607 0 0 0 65.157 21.092V122.688zm17.687.314v266.125a133.607 133.607 0 0 0 63.438-22.03V145a133.607 133.607 0 0 0-63.438-22zm-100.5 34.344A133.607 133.607 0 0 0 122.405 256a133.607 133.607 0 0 0 43.72 98.78V157.345zm-60.72 1.625 8.907 5.155v10.28l-8.906 5.157-8.937-5.156v-10.28l8.936-5.157zm300.5 0 8.94 5.155v10.28l-8.94 5.157-8.905-5.156v-10.28l8.906-5.157zm-58.155.093V353.03A133.607 133.607 0 0 0 389.594 256a133.607 133.607 0 0 0-41.844-96.938zm57.813 173.125 8.937 5.156v10.312l-8.938 5.156-8.906-5.156v-10.312l8.906-5.156zm-299.813.718 8.938 5.156v10.313l-8.938 5.156-8.938-5.155v-10.313l8.938-5.156zm149.906 85.188 8.938 5.156v10.313l-8.938 5.156-8.906-5.158v-10.31l8.906-5.156z" fill="currentColor"></path></g></svg>, "Defense", _hero.Defense, "text-warning")
    
                        <!-- Agility: Ícone Verde (text-success), Número Verde (text-success) -->
                        @StatBox(@<svg class="stat-icon-large text-danger" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M0 0h512v512H0z" fill="none"></path><g transform="translate(0,0)"><path d="M134.924 42.201c-8.034.11-27.397 3.323-49.424 6.893l7.604 22.027c43.938-5.873 43.678-7.054 46.89-2.572 32.14 44.839 59.603 88.148 74.676 135.023 32.603 2.41 71.533 9.14 98.31 23.852 34.083-36.34 89.673-55.812 135.497-71.701 12.157-4.216 25.246 7.4 42.47 10.068l4.848-17.264c-4.872-6.815-27.807-16.587-37.338-16.718-4.035-.056-15.496 3.15-18.969 4.341-56.98 11.002-103.367 13.182-162.199 32.575-37.228-37.914-76.205-75.414-120.932-113.803-9.238-7.93-9.691-12.88-21.433-12.72zm83.87 179.617c-14.884 26.18-24.332 32.5-44.718 46.17-17.912-4.68-35.784-9.45-56.758-6.986-21.017-2.805-29.586 4.975-55.086 13.9-7.727-2.6-16.961.997-22.898 3.528-9.757 4.976-21.342 12.282-18.766 24.588 3.949 12.712 20.223 8.898 27.655 5.703 6.245-2.98 12.055-8.777 16.357-13.34 21.38.569 30.874-.128 52.988-9.912 16.743 6.801 37.917 9.505 56.895 9.972a57.14 57.14 0 0 1 3.607-2.476c10.976-6.9 24.287-9.537 36.313-4.77 12.025 4.768 19.744 15.743 22.773 28.196 1.789 7.352 2.081 15.356.856 23.539 4.75 13.328 8.36 25.571 16.906 41.912-5.193 22.78-3.544 45.283-2.262 68.342l-22.781 8.55-4.34 11.069h70.213l-8.137-11.903-16.369-8.257c3.504-23.007 9.628-45.75 6.246-69.446.55-17.704-5.289-35.407-8.748-53.111 21.304-26.239 10.374-44.741 25.3-73.287a112.733 112.733 0 0 1 7.216-11.918c-27.363-11.34-54.484-18.839-82.461-20.063zm-18.15 81.842c-4.054.12-8.442 1.56-12.992 4.42-7.278 4.576-14.383 12.805-18.76 23.463-4.376 10.658-5.073 21.43-3.064 29.687 2.009 8.258 6.29 13.613 12.037 15.891 5.747 2.278 12.612 1.343 19.89-3.232 7.28-4.576 14.386-12.807 18.763-23.465 4.376-10.658 5.071-21.428 3.062-29.686s-6.289-13.614-12.035-15.892c-2.155-.855-4.468-1.258-6.9-1.186z" fill="currentColor"></path></g></svg>, "Agility", _hero.Agility, "text-warning")
    
                        <!-- Magic: Ícone Ciano (text-info), Número Ciano (text-info) -->
                        @StatBox(@<svg class="stat-icon-large text-danger" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M0 0h512v512H0z" fill="none"></path><g transform="translate(0,0)"><path d="M319.61 20.654c13.145 33.114 13.144 33.115-5.46 63.5 33.114-13.145 33.116-13.146 63.5 5.457-13.145-33.114-13.146-33.113 5.457-63.498-33.114 13.146-33.113 13.145-63.498-5.459zM113.024 38.021c-11.808 21.04-11.808 21.04-35.724 24.217 21.04 11.809 21.04 11.808 24.217 35.725 11.808-21.04 11.808-21.04 35.724-24.217-21.04-11.808-21.04-11.808-24.217-35.725zm76.55 56.184c-.952 50.588-.95 50.588-41.991 80.18 50.587.95 50.588.95 80.18 41.99.95-50.588.95-50.588 41.99-80.18-50.588-.95-50.588-.95-80.18-41.99zm191.177 55.885c-.046 24.127-.048 24.125-19.377 38.564 24.127.047 24.127.046 38.566 19.375.047-24.126.046-24.125 19.375-38.564-24.126-.047-24.125-.046-38.564-19.375zm-184.086 83.88a96.38 96.38 0 0 0-3.492.134c-18.591 1.064-41.868 8.416-77.445 22.556L76.012 433.582c78.487-20.734 132.97-21.909 170.99-4.615V247.71c-18.076-8.813-31.79-13.399-46.707-13.737a91.166 91.166 0 0 0-3.629-.002zm122.686 11.42a209.3 209.3 0 0 0-8.514.098c-12.81.417-27.638 2.215-45.84 4.522v177.135c43.565-7.825 106.85-4.2 171.244 7.566l-39.78-177.197c-35.904-8.37-56.589-11.91-77.11-12.123zm2.289 16.95c18.889.204 36.852 2.768 53.707 5.02l4.437 16.523c-23.78-3.75-65.966-4.906-92.467-.98l-.636-17.805c11.959-2.154 23.625-2.88 34.959-2.758zm-250.483 4.658L60.54 313.002h24.094l10.326-46.004H71.158zm345.881 0 39.742 177.031 2.239 9.973 22.591-.152-40.855-186.852h-23.717zm-78.857 57.82c16.993.026 33.67.791 49.146 2.223l3.524 17.174c-32.645-3.08-72.58-2.889-102.995 0l-.709-17.174c16.733-1.533 34.04-2.248 51.034-2.223zm-281.793 6.18-6.924 30.004h24.394l6.735-30.004H56.389zm274.418 27.244c4.656.021 9.487.085 14.716.203l2.555 17.498c-19.97-.471-47.115.56-59.728 1.05l-.7-17.985c16.803-.493 29.189-.828 43.157-.766zm41.476.447c8.268.042 16.697.334 24.121.069l2.58 17.74c-8.653-.312-24.87-.83-32.064-.502l-2.807-17.234a257.25 257.25 0 0 1 8.17-.073zm-326.97 20.309-17.985 77.928 25.035-.17 17.455-77.758H45.313zm303.164 11.848c19.608-.01 38.66.774 56.449 2.572l2.996 20.787c-34.305-4.244-85.755-7.697-119.1-3.244l-.14-17.922c20.02-1.379 40.186-2.183 59.795-2.193zm-166.606 44.05c-30.112.09-67.916 6.25-115.408 19.76l-7.22 2.053 187.759-1.27v-6.347c-16.236-9.206-37.42-14.278-65.13-14.196zm134.41 6.174c-19.63.067-37.112 1.439-51.283 4.182v10.064l177.594-1.203c-44.322-8.634-89.137-13.17-126.31-13.043zM26 475v18h460v-18H26z" fill="currentColor"></path></g></svg>, "Magic", _hero.Magic, "text-warning")
    
                        <!-- Magic Def: Ícone Branco (text-light), Número Branco (text-light) -->
                        @StatBox(@<svg class="stat-icon-large text-danger" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M0 0h512v512H0z" fill="none"></path><g transform="translate(0,0)"><path d="m19.36 19.457-.38 27.84 267.127 154.75-58.703 19.916 57.602 19.36L142.12 383.546l-19.214-19.213-51.47 114.324 123.125-43.482-17.492-18.95 151.868-151.87 12.433 43.078 22.976-68.5 56.675-16.565-57.475-15.492-22.934-79.828-14.145 48.266-268.65-155.41-38.454-.446zM370.614 81.94c-4.53.02-9.035.12-13.51.302-3.275.134-6.528.32-9.76.547l31.25 108.786 104.05 28.045c6.204-39.085 8.902-80.275 9.18-120.075C456.37 88.82 415.098 82.257 375.15 81.95a403.83 403.83 0 0 0-4.537-.01zm-36.87 2.1c-31.99 3.653-61.013 12.153-83.014 25.87l64.493 37.31 18.52-63.18zm148.18 139.997L378.958 254.13l-38.93 116.054-20.268-70.225-39.07 39.067c18.814 35.364 46.1 62.287 86.175 77.604 47.473-17.834 78.566-62.795 98.014-121.6 7.323-22.14 12.905-46.11 17.042-70.993z" fill="currentColor"></path></g></svg>, "Magic Def", _hero.MagicDefense, "text-warning")
                    </div>
                </div>

                <!-- PARTE DE BAIXO: TRAITS PASSIVOS (Empilhados Verticalmente) -->
                @if (_hero.Traits.Any())
                {
                    <div class="mt-2 d-flex flex-column flex-grow-1">
                        <h4 class="text-warning border-bottom border-secondary pb-2 mb-3">Passive Traits</h4>

                        <div class="d-flex flex-column gap-3 align-items-stretch">
                            @foreach (var trait in _hero.Traits)
                            {
                                <div class="p-3 bg-black border border-secondary rounded shadow-sm">
                                    <h6 class="fw-bold mb-2">
                                        <span class="@(trait.IsRacial ? "text-success" : "text-warning")">@trait.SourceName Trait</span>
                                        <span class="text-light"> - </span>
                                        <span class="text-info">@trait.Name</span>
                                    </h6>
                                    <div class="text-light small mb-0">
                                        @foreach(var line in trait.DescriptionLines)
                                        {
                                            @if (string.IsNullOrEmpty(line))
                                            {
                                                <br />
                                            }
                                            else
                                            {
                                                @line <br />
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- BLOCO INFERIOR: Habilidades (Full Width) -->
        <div class="row">
            <div class="col-12">
                <h4 class="text-warning border-bottom border-secondary pb-2 mb-4">Known Abilities</h4>

                <div class="row">
                    @foreach (var ability in _hero.Abilities)
                    {
                        <div class="col-xl-6 col-lg-12 mb-3">
                            <div class="card bg-dark border-secondary shadow-sm d-flex flex-row overflow-hidden h-100 ability-card">
                                <div class="ability-icon-col" style="background-image: url('@AssetService.GetAbilityIconUrl(ability.Id)');"></div>

                                <div class="card-body p-3 d-flex flex-column justify-content-between w-100">
                                    <div>
                                        <!-- TOPO: Nome da Habilidade e Badges de AP/CD -->
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="text-info fw-bold mb-0">@ability.Name</h5>
                                            <div class="d-flex gap-2">
                                                <span class="badge bg-secondary border border-dark" title="Action Point Cost">⚡ @ability.ActionPointCost AP</span>
                                                <span class="badge bg-secondary border border-dark" title="Base Cooldown">⏳ @ability.BaseCooldown CD</span>
                                            </div>
                                        </div>
                                        
                                        <div class="mb-2">
                                            @if(ability.Tags != null)
                                            {
                                                foreach(var tag in ability.Tags) { <span class="badge bg-secondary me-1">@tag</span> }
                                            }
                                        </div>
                                        <p class="card-text text-light small mb-2">@ability.Description</p>

                                        <!-- MATEMÁTICA E MODIFICADORES -->
                                        @if(ability.Effects != null && ability.Effects.Any())
                                        {
                                            <div class="effect-math-box p-2 mb-2 rounded border border-secondary">
                                                @foreach(var eff in ability.Effects)
                                                {
                                                    @if (eff.Type == EffectType.DAMAGE || eff.Type == EffectType.HEAL)
                                                    {
                                                        var isHeal = eff.Type == EffectType.HEAL;
                                                        var colorClass = isHeal ? "text-success" : "text-danger";
                                                        var actionText = isHeal ? "Healing" : "Damage";

                                                        <div class="d-flex justify-content-between align-items-center mb-1 effect-row">
                                                            <span>
                                                                <span class="@colorClass fw-bold fs-6">@eff.PredictedValue</span> 
                                                                <span class="text-light">@actionText</span>
                                                            </span>
                                                            <span class="effect-text-secondary">
                                                                (Base @eff.BaseAmount + @((int)Math.Round(eff.ScalingFactor * 100))% @eff.ScalingStat)
                                                            </span>
                                                        </div>
                                                    }
                                                    else if (eff.Type == EffectType.APPLY_MODIFIER && !string.IsNullOrEmpty(eff.ModifierName))
                                                    {
                                                        <div class="d-flex flex-column mb-1 effect-row">
                                                            <div class="d-flex justify-content-between align-items-center">
                                                                <span class="text-warning fw-bold">🛡️ Applies @eff.ModifierName</span>
                                                                @if (eff.DurationInTurns == -1)
                                                                {
                                                                    <span class="text-info small fw-bold">Permanent</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-info small fw-bold">@eff.DurationInTurns Turn@(eff.DurationInTurns > 1 ? "s" : "")</span>
                                                                }
                                                            </div>
                                                            <span class="effect-text-secondary">@eff.ModifierDescription</span>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                    
                                    <!-- CUSTOS (Essence e HP) -->
                                    <div class="d-flex gap-3 mt-2 flex-wrap align-items-center">
                                        @if (ability.Costs != null)
                                        {
                                            foreach(var cost in ability.Costs.Where(c => c.Value > 0))
                                            {
                                                <div class="d-flex align-items-center" title="@cost.Key Essence">
                                                    <span class="fw-bold text-light me-1">@cost.Value</span><span class="text-muted small me-2">x</span>
                                                    <div class="cost-essence-icon" style="background-image: url('@AssetService.GetEssenceIconUrl(cost.Key.ToString())');"></div>
                                                </div>
                                            }
                                        }
                                        @if (ability.HPCost > 0)
                                        {
                                            <div class="d-flex align-items-center" title="Health Points">
                                                <span class="fw-bold text-danger me-1">@ability.HPCost</span>
                                                <span class="text-muted small me-2">x</span>
                                                <div class="cost-hp-icon d-flex justify-content-center align-items-center">❤️</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string DefinitionId { get; set; } = string.Empty;

    private HeroDetailsDto? _hero;
    private TavernHeroDto? _tavernInfo;
    
    private string? _errorMessage;
    private string? _purchaseError;
    private string? _purchaseSuccess;
    private bool _isPurchasing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadHeroDataAsync();
    }

    private async Task LoadHeroDataAsync()
    {
        try 
        { 
            // Paraleliza os pedidos ao Backend
            var heroTask = Http.GetFromJsonAsync<HeroDetailsDto>($"api/character/{DefinitionId}");
            var tavernTask = Http.GetFromJsonAsync<TavernHeroDto>($"api/tavern/{DefinitionId}");

            await Task.WhenAll(heroTask, tavernTask);

            _hero = heroTask.Result;
            _tavernInfo = tavernTask.Result;
        }
        catch (Exception) 
        { 
            _errorMessage = "Failed to load hero details. They might not exist."; 
        }
    }

    private async Task PurchaseHeroAsync()
    {
        _isPurchasing = true;
        _purchaseError = null;
        _purchaseSuccess = null;

        try
        {
            var request = new PurchaseHeroRequest { HeroId = DefinitionId };
            var response = await Http.PostAsJsonAsync("api/tavern/purchase", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PurchaseHeroResponse>();
                if (result != null && result.Success)
                {
                    _purchaseSuccess = "Hero successfully recruited to your Guild!";
                    
                    // Recarregar os dados para atualizar a UI do widget da taverna para "Owned"
                    await LoadHeroDataAsync();
                }
            }
            else
            {
                // A nossa API devolve códigos 400 com RFC 7807 ProblemDetails se faltar dinheiro ou condições
                _purchaseError = "Could not complete the purchase. Check if you have enough gold.";
            }
        }
        catch
        {
            _purchaseError = "Connection error while attempting to purchase.";
        }
        finally
        {
            _isPurchasing = false;
        }
    }

    private async Task GoBack()
    {
        // Interop mágico com JS nativo. Devolve o jogador para a Taverna ou Guilda consoante de onde veio.
        await JS.InvokeVoidAsync("history.back");
    }

