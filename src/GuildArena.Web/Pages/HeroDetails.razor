@page "/hero/{DefinitionId}"
@attribute [Authorize]
@using GuildArena.Shared.DTOs.GuildAndHeroes
@using GuildArena.Shared.DTOs.Combat
@using GuildArena.Shared.DTOs.Shop
@using GuildArena.Shared.Requests
@using GuildArena.Domain.Enums.Combat
@using GuildArena.Domain.Enums.UnlockHero
@using GuildArena.Web.Services
@using GuildArena.Web.Components
@inject HttpClient Http
@inject IAssetService AssetService

<PageTitle>@(_hero is null ? "Hero Details" : $"{_hero.Name} · Hero Details")</PageTitle>

<div class="hero-page">
    <a class="hero-back" href="@(From == "tavern" ? "/tavern" : "/guild")">
        <span aria-hidden="true">←</span> Back to @(From == "tavern" ? "Tavern" : "Guild")
    </a>

    @if (_errorMessage is not null)
    {
        <section class="hero-state hero-state-error" role="alert" aria-labelledby="hero-state-title">
            <p class="hero-eyebrow">Hero register</p>
            <h1 id="hero-state-title">@(_heroNotFound ? "Hero not found" : "Hero details unavailable")</h1>
            <p>@_errorMessage</p>
            @if (_purchaseSuccess is not null)
            {
                <p>@_purchaseSuccess</p>
            }
            @if (!_heroNotFound)
            {
                <button type="button" @onclick="LoadHeroDataAsync">Try again</button>
            }
        </section>
    }
    else if (_isLoading || _hero is null || _tavernInfo is null)
    {
        <div class="hero-state" role="status">
            <h1>Hero details</h1>
            <p>Loading hero details...</p>
        </div>
    }
    else
    {
        <div class="hero-overview">
            <div class="hero-side">
                <div class="hero-portrait">
                    <img src="@AssetService.GetPortraitUrl(_hero.DefinitionId)" alt="Portrait of @_hero.Name" />
                </div>

                <section class="hero-recruitment" aria-labelledby="recruitment-title">
                    <p class="hero-eyebrow">Guild collection</p>
                    <h2 id="recruitment-title">Recruitment</h2>

                    @if (_purchaseSuccess is not null)
                    {
                        <p class="recruitment-feedback recruitment-success" role="status">@_purchaseSuccess</p>
                    }
                    @if (_purchaseError is not null)
                    {
                        <p class="recruitment-feedback recruitment-error" role="alert">@_purchaseError</p>
                    }

                    @if (_tavernInfo.Status == HeroStatus.Owned)
                    {
                        <p class="recruitment-owned"><span aria-hidden="true">✓</span> In roster</p>
                    }
                    else if (_tavernInfo.Status == HeroStatus.Locked)
                    {
                        <p class="recruitment-status">Recruitment locked</p>
                        @if (_tavernInfo.UnlockConditions.Count > 0)
                        {
                            <UnlockRequirements Conditions="_tavernInfo.UnlockConditions" />
                        }
                        <p class="recruitment-price"><span>Recruitment cost</span><strong><GoldAmount Value="_tavernInfo.GoldCost" /></strong></p>
                        <button class="recruitment-action" type="button" disabled>Recruitment locked</button>
                    }
                    else if (_tavernInfo.Status == HeroStatus.Available)
                    {
                        <p class="recruitment-status">Unlocked · recruitment available</p>
                        <p class="recruitment-price"><span>Recruitment cost</span><strong><GoldAmount Value="_tavernInfo.GoldCost" /></strong></p>
                        <button class="recruitment-action" type="button" disabled="@_isPurchasing" @onclick="PurchaseHeroAsync">
                            @(_isPurchasing ? "Signing..." : "Recruit hero")
                        </button>
                        <p class="recruitment-note">Your guild's gold and eligibility are confirmed when you recruit.</p>
                    }
                </section>
            </div>

            <div class="hero-details">
                <header class="hero-identity">
                    <p class="hero-eyebrow">Hero register / Profile</p>
                    <h1>@_hero.Name</h1>
                    <p class="hero-race">@_hero.RaceName <span aria-hidden="true">·</span> Level @_hero.CurrentLevel</p>
                    <div class="hero-vitals" aria-label="Hero resources">
                        <div class="hero-vital">
                            <span>Health points</span>
                            <strong>@_hero.MaxHP <small>max <ResourceIcon Kind="ResourceIconKind.HealthPoints" /></small></strong>
                        </div>
                        <div class="hero-vital">
                            <span>Action points</span>
                            <strong>@_hero.MaxActions <small>max <ResourceIcon Kind="ResourceIconKind.ActionPoints" /></small></strong>
                        </div>
                    </div>
                </header>

                <section class="hero-attributes" aria-labelledby="attributes-title">
                    <div class="hero-section-heading">
                        <p class="hero-eyebrow">At a glance</p>
                        <h2 id="attributes-title">Combat attributes</h2>
                    </div>
                    <dl class="hero-attribute-list">
                        <div><dt><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 19 5-5m2-2 8-8-4 1-7 7 3 3 7-7 1-4M3 17l4 4m-4 0 4-4" /></svg>Attack</dt><dd>@_hero.Attack</dd></div>
                        <div><dt><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3 8 8 11 5-3 8-6 8-11V5l-8-3Zm0 4v12m-4-8h8" /></svg>Defense</dt><dd>@_hero.Defense</dd></div>
                        <div><dt><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17c5 0 6-4 10-4h7M3 12c3 0 5-5 9-5h8M7 21c3 0 4-3 8-3h5" /></svg>Agility</dt><dd>@_hero.Agility</dd></div>
                        <div><dt><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2L12 2Z" /></svg>Magic</dt><dd>@_hero.Magic</dd></div>
                        <div><dt><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3 8 8 11 5-3 8-6 8-11V5l-8-3Zm0 5 1.2 3.8L17 12l-3.8 1.2L12 17l-1.2-3.8L7 12l3.8-1.2L12 7Z" /></svg>Magic defense</dt><dd>@_hero.MagicDefense</dd></div>
                    </dl>
                </section>

                @if (_hero.Traits.Any())
                {
                    <section class="hero-traits" aria-labelledby="traits-title">
                        <div class="hero-section-heading">
                            <p class="hero-eyebrow">Hero profile</p>
                            <h2 id="traits-title">Passive traits</h2>
                        </div>
                        <div class="trait-list">
                            @foreach (var trait in _hero.Traits)
                            {
                                <article class="trait-card">
                                    <p class="trait-source">@trait.SourceName Trait</p>
                                    <h3>@trait.Name</h3>
                                    <div class="trait-description">
                                        @foreach(var line in trait.DescriptionLines)
                                        {
                                            @if (string.IsNullOrEmpty(line))
                                            {
                                                <br />
                                            }
                                            else
                                            {
                                                @line <br />
                                            }
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }
            </div>
        </div>

        <section class="hero-abilities" aria-labelledby="abilities-title">
            <div class="hero-section-heading">
                <p class="hero-eyebrow">Hero repertoire</p>
                <h2 id="abilities-title">Known abilities</h2>
            </div>

            <div class="ability-list">
                @if (_hero.Abilities.Count == 0)
                {
                    <p class="ability-empty">No known abilities are listed for this hero.</p>
                }
                @foreach (var ability in _hero.Abilities)
                {
                    <article class="ability-card">
                        <header class="ability-header">
                            <img class="ability-icon" src="@AssetService.GetAbilityIconUrl(ability.Id)" alt="" loading="lazy" />
                            <div class="ability-heading">
                                <h3>@ability.Name</h3>
                                <div class="ability-meta">
                                    <span><ResourceIcon Kind="ResourceIconKind.ActionPoints" /><span><strong>@ability.ActionPointCost</strong> AP cost</span></span>
                                    <span><ResourceIcon Kind="ResourceIconKind.Cooldown" /><span>@(ability.BaseCooldown == 0 ? "No cooldown" : $"{ability.BaseCooldown} turn{(ability.BaseCooldown == 1 ? "" : "s")} cooldown")</span></span>
                                </div>
                            </div>
                        </header>

                        <div class="ability-content">
                            @if (ability.Tags is { Count: > 0 })
                            {
                                <div class="ability-tags" aria-label="Ability tags">
                                    @foreach (var tag in ability.Tags)
                                    {
                                        <span>@tag</span>
                                    }
                                </div>
                            }

                            <p class="ability-description">@ability.Description</p>

                            @if (ability.Effects is { Count: > 0 })
                            {
                                <div class="ability-effects">
                                    @foreach (var eff in ability.Effects)
                                    {
                                        @if (eff.Type == EffectType.DAMAGE || eff.Type == EffectType.HEAL)
                                        {
                                            var isHeal = eff.Type == EffectType.HEAL;
                                            <div class="ability-effect">
                                                <div class="ability-effect-summary">
                                                    <strong class="@(isHeal ? "ability-heal" : "ability-damage")">@eff.PredictedValue @(isHeal ? "Healing" : "Damage")</strong>
                                                </div>
                                                <details class="ability-breakdown">
                                                    <summary>How this value is described</summary>
                                                    <p>Base @eff.BaseAmount + @((int)Math.Round(eff.ScalingFactor * 100))% @eff.ScalingStat scaling. The predicted value is supplied by the server; actual combat effects may vary.</p>
                                                </details>
                                            </div>
                                        }
                                        else if (eff.Type == EffectType.APPLY_MODIFIER && !string.IsNullOrEmpty(eff.ModifierName))
                                        {
                                            <div class="ability-effect">
                                                <div class="ability-effect-summary">
                                                    <strong>Applies @eff.ModifierName</strong>
                                                    <span>@(eff.DurationInTurns == -1 ? "Permanent" : $"{eff.DurationInTurns} Turn{(eff.DurationInTurns > 1 ? "s" : "")}")</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(eff.ModifierDescription))
                                                {
                                                    <p class="ability-effect-detail">@eff.ModifierDescription</p>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }

                            @if (ability.Costs?.Any(c => c.Value > 0) == true || ability.HPCost > 0)
                            {
                                <div class="ability-costs">
                                    <h4>Resource costs</h4>
                                    <div class="ability-cost-list">
                                        @if (ability.Costs != null)
                                        {
                                            @foreach (var cost in ability.Costs.Where(c => c.Value > 0))
                                            {
                                                <span class="ability-cost">
                                                    <img src="@AssetService.GetEssenceIconUrl(cost.Key.ToString())" alt="" loading="lazy" />
                                                    <strong>@cost.Value</strong> @cost.Key Essence
                                                </span>
                                            }
                                        }
                                        @if (ability.HPCost > 0)
                                        {
                                            <span class="ability-cost"><ResourceIcon Kind="ResourceIconKind.HealthPoints" /> <strong>@ability.HPCost</strong> HP</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>

@code {
    [Parameter]
    public string DefinitionId { get; set; } = string.Empty;

    [Parameter, SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    private HeroDetailsDto? _hero;
    private TavernHeroDto? _tavernInfo;
    private bool _isLoading = true;
    private bool _heroNotFound;
    private string? _errorMessage;
    private string? _purchaseError;
    private string? _purchaseSuccess;
    private bool _isPurchasing;

    protected override async Task OnParametersSetAsync()
    {
        _purchaseError = null;
        _purchaseSuccess = null;
        await LoadHeroDataAsync();
    }

    private async Task LoadHeroDataAsync()
    {
        _isLoading = true;
        _hero = null;
        _tavernInfo = null;
        _errorMessage = null;
        _heroNotFound = false;

        try
        {
            var id = Uri.EscapeDataString(DefinitionId);
            var heroTask = Http.GetAsync($"api/character/{id}");
            var tavernTask = Http.GetAsync($"api/tavern/{id}");
            await Task.WhenAll(heroTask, tavernTask);

            using var heroResponse = await heroTask;
            using var tavernResponse = await tavernTask;
            if (heroResponse.StatusCode == System.Net.HttpStatusCode.NotFound ||
                tavernResponse.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _heroNotFound = true;
                _errorMessage = "This hero could not be found. Check the link or return to your collection.";
                return;
            }

            heroResponse.EnsureSuccessStatusCode();
            tavernResponse.EnsureSuccessStatusCode();
            var hero = await heroResponse.Content.ReadFromJsonAsync<HeroDetailsDto>();
            var tavernInfo = await tavernResponse.Content.ReadFromJsonAsync<TavernHeroDto>();
            if (hero is null || tavernInfo is null)
            {
                _errorMessage = "We couldn't load this hero's details. Please try again.";
                return;
            }

            _hero = hero;
            _tavernInfo = tavernInfo;
        }
        catch (Exception)
        {
            _errorMessage = "We couldn't load this hero's details. Check your connection and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task PurchaseHeroAsync()
    {
        if (_isPurchasing || _tavernInfo?.Status != HeroStatus.Available) return;

        _isPurchasing = true;
        _purchaseError = null;
        _purchaseSuccess = null;

        try
        {
            var request = new PurchaseHeroRequest { HeroId = DefinitionId };
            using var response = await Http.PostAsJsonAsync("api/tavern/purchase", request);
            var (success, message) = await RecruitmentFeedback.ReadResultAsync(response);
            if (success)
            {
                _purchaseSuccess = "Hero recruited to your guild.";
                await LoadHeroDataAsync();
            }
            else
            {
                _purchaseError = message;
            }
        }
        catch
        {
            _purchaseError = "Connection error during recruitment. Refresh the page to confirm the hero's status before trying again.";
        }
        finally
        {
            _isPurchasing = false;
        }
    }
}
