@page "/tavern"
@attribute [Authorize]
@using GuildArena.Shared.DTOs.Shop
@using GuildArena.Domain.Enums.UnlockHero
@using GuildArena.Web.Components
@using GuildArena.Web.Services
@inject HttpClient Http
@inject IAssetService AssetService

<PageTitle>Hero Tavern</PageTitle>

<div class="tavern-page">
    <header class="tavern-header">
        <div>
            <p class="tavern-eyebrow">Guild collection / Recruitment</p>
            <h1>The Tavern</h1>
            <p>Discover new heroes, review their abilities, and recruit them for your guild.</p>
        </div>
        @if (_shopData is not null && !_isLoading)
        {
            <div class="tavern-funds">
                <span>Guild funds</span><strong><GoldAmount Value="_shopData.GuildGold" /></strong>
            </div>
        }
    </header>

    @if (_purchaseSuccess is not null && _shopData is not { Heroes.Count: > 0 })
    {
        <p class="tavern-feedback tavern-success" role="status">@_purchaseSuccess</p>
    }
    @if (_purchaseError is not null && _shopData is not { Heroes.Count: > 0 })
    {
        <p class="tavern-feedback tavern-error" role="alert">@_purchaseError</p>
    }

    @if (_isLoading)
    {
        <div class="tavern-state" role="status">Loading Tavern heroes...</div>
    }
    else if (_loadError is not null)
    {
        <section class="tavern-state tavern-state-error" role="alert">
            <h2>Tavern unavailable</h2>
            <p>@_loadError</p>
            <button type="button" @onclick="LoadShopDataAsync">Try again</button>
        </section>
    }
    else if (_shopData is { Heroes.Count: 0 })
    {
        <div class="tavern-state">No heroes are listed at the Tavern right now.</div>
    }
    else if (_shopData is not null)
    {
        var groups = new[]
        {
            (Id: "recruited", Title: "Recruited heroes", Description: "Heroes already in your guild's roster.",
                Heroes: _shopData.Heroes.Where(hero => hero.Status == HeroStatus.Owned).ToList()),
            (Id: "prospects", Title: "Heroes to recruit", Description: "Review costs and unlock requirements before recruiting.",
                Heroes: _shopData.Heroes.Where(hero => hero.Status != HeroStatus.Owned).ToList())
        };
        @foreach (var group in groups)
        {
            <section class="tavern-section" aria-labelledby="@($"tavern-{group.Id}-title")">
                <header class="tavern-section-heading">
                    <div>
                        <p class="tavern-eyebrow">Guild collection</p>
                        <h2 id="@($"tavern-{group.Id}-title")">@group.Title</h2>
                        <p>@group.Description</p>
                    </div>
                    <span class="tavern-count">@group.Heroes.Count @(group.Heroes.Count == 1 ? "hero" : "heroes")</span>
                </header>
                @if (group.Heroes.Count == 0)
                {
                    <p class="tavern-group-empty">@(group.Id == "recruited" ? "No heroes recruited yet." : "All Tavern heroes are in your roster.")</p>
                }
                else
                {
                    <div class="tavern-list">
                    @foreach (var hero in group.Heroes)
                    {
                        var canAfford = _shopData.GuildGold >= hero.GoldCost;
                        var isPurchasing = _purchasingHeroId == hero.DefinitionId;
                        <article class="tavern-hero" @key="hero.DefinitionId">
                            <a class="tavern-portrait" href="@HeroUrl(hero.DefinitionId)" aria-label="Inspect @hero.Name">
                                <img src="@AssetService.GetPortraitUrl(hero.DefinitionId)" alt="" loading="lazy" />
                            </a>
                            <div class="tavern-hero-body">
                                @if (_feedbackHeroId == hero.DefinitionId && _purchaseSuccess is not null)
                                {
                                    <p class="tavern-feedback tavern-success" role="status">@_purchaseSuccess</p>
                                }
                                @if (_feedbackHeroId == hero.DefinitionId && _purchaseError is not null)
                                {
                                    <p class="tavern-feedback tavern-error" role="alert">@_purchaseError</p>
                                }
                                <div class="tavern-hero-heading">
                                    <div>
                                        <p class="tavern-eyebrow">@hero.RaceName</p>
                                        <h3>@hero.Name</h3>
                                    </div>
                                    <span class="tavern-status">@(hero.Status switch { HeroStatus.Owned => "In roster", HeroStatus.Locked => "Locked", _ => "Available" })</span>
                                </div>

                                @if (hero.Status == HeroStatus.Locked && hero.UnlockConditions.Count > 0)
                                {
                                    <UnlockRequirements Conditions="hero.UnlockConditions" />
                                }

                                @if (hero.Status != HeroStatus.Owned)
                                {
                                    <p class="tavern-price"><span>Recruitment cost</span><strong><GoldAmount Value="hero.GoldCost" /></strong></p>
                                }

                                @if (hero.Status == HeroStatus.Available && !canAfford)
                                {
                                    <p class="tavern-shortfall">Not enough gold · need <GoldAmount Value="@(hero.GoldCost - _shopData.GuildGold)" /> more</p>
                                }

                                <div class="tavern-actions">
                                    <a href="@HeroUrl(hero.DefinitionId)">Inspect hero <span aria-hidden="true">→</span></a>
                                    @if (hero.Status == HeroStatus.Available)
                                    {
                                        <button type="button" disabled="@(!canAfford || _isProcessingPurchase)"
                                                @onclick="() => PurchaseHeroAsync(hero.DefinitionId)">
                                            @(isPurchasing ? "Signing..." : canAfford ? "Recruit hero" : "Insufficient gold")
                                        </button>
                                    }
                                    else if (hero.Status == HeroStatus.Locked)
                                    {
                                        <span class="tavern-unavailable">Complete the requirements to recruit</span>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                    </div>
                }
            </section>
        }
    }
</div>

@code {
    private TavernShopDto? _shopData;
    private string? _loadError;
    private string? _purchaseError;
    private string? _purchaseSuccess;
    private string? _feedbackHeroId;
    private bool _isLoading = true;
    private bool _isProcessingPurchase;
    private string? _purchasingHeroId;

    protected override async Task OnInitializedAsync() => await LoadShopDataAsync();

    private static string HeroUrl(string definitionId) => $"/hero/{Uri.EscapeDataString(definitionId)}?from=tavern";

    private async Task LoadShopDataAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            _shopData = await Http.GetFromJsonAsync<TavernShopDto>("api/tavern");
            if (_shopData is null) throw new InvalidOperationException("Empty Tavern response");
        }
        catch (Exception)
        {
            _shopData = null;
            _loadError = "We couldn't load current heroes and guild funds. Check your connection and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task PurchaseHeroAsync(string definitionId)
    {
        if (_isProcessingPurchase || _shopData?.Heroes.FirstOrDefault(h => h.DefinitionId == definitionId) is not { Status: HeroStatus.Available } hero ||
            _shopData.GuildGold < hero.GoldCost) return;

        _isProcessingPurchase = true;
        _purchasingHeroId = definitionId;
        _feedbackHeroId = definitionId;
        _purchaseError = null;
        _purchaseSuccess = null;

        try
        {
            using var response = await Http.PostAsJsonAsync("api/tavern/purchase", new PurchaseHeroRequest { HeroId = definitionId });
            var (success, message) = await RecruitmentFeedback.ReadResultAsync(response);
            if (success)
            {
                _purchaseSuccess = $"{hero.Name} was recruited to your guild.";
                await LoadShopDataAsync();
            }
            else
            {
                _purchaseError = message;
            }
        }
        catch (Exception)
        {
            _purchaseError = "Connection error during recruitment. Refresh the Tavern to confirm ownership before trying again.";
        }
        finally
        {
            _isProcessingPurchase = false;
            _purchasingHeroId = null;
        }
    }
}
