@page "/dungeons"
@attribute [Authorize]
@using System.Net
@using System.Text.Json
@using GuildArena.Shared.DTOs.GuildAndHeroes
@using GuildArena.Shared.DTOs.Dungeons
@using GuildArena.Shared.Requests
@using GuildArena.Web.Services
@using GuildArena.Web.State
@inject HttpClient Http
@inject IAssetService AssetService
@inject ICombatStateService CombatService
@inject NavigationManager NavManager

<PageTitle>Dungeons &amp; Camp</PageTitle>

<div class="dungeons-page">
    <header class="page-intro">
        <p class="eyebrow">Guild register / Expeditions</p>
        <h1>Dungeons &amp; Camp</h1>
        <p>Prepare three heroes for a dungeon run, or continue your active expedition from camp.</p>
    </header>

    @if (_campLoading)
    {
        <p class="state-panel" role="status">Checking for an active expedition...</p>
    }
    else if (_campError)
    {
        <div class="state-panel state-error" role="alert">
            <h2>Expedition status unavailable</h2>
            <p>We couldn't check whether you have an active run. Check again before starting another expedition.</p>
            <button type="button" disabled="@_isProcessing" @onclick="LoadStateAsync">Check expedition status</button>
        </div>
    }
    else if (_activeCamp is { } camp)
    {
        <section class="camp-section" aria-labelledby="camp-title">
            <div class="camp-heading">
                <div>
                    <p class="eyebrow">Active expedition / Camp</p>
                    <h2 id="camp-title">@camp.DungeonName</h2>
                    <p>Your heroes keep their current HP between stages.</p>
                </div>
                <div class="stage-marker">
                    <span>Next stage</span>
                    <strong>Stage @(camp.CurrentStageIndex + 1)</strong>
                    @if (camp.IsBossNode)
                    {
                        <span class="boss-marker">Boss stage</span>
                    }
                </div>
            </div>

            <div class="section-heading">
                <div>
                    <p class="eyebrow">Expedition party</p>
                    <h3>Heroes at camp</h3>
                </div>
                <span class="section-count">@camp.Heroes.Count @((camp.Heroes.Count == 1) ? "hero" : "heroes")</span>
            </div>
            @if (camp.Heroes.Count == 0)
            {
                <div class="state-panel"><p>No hero information is available for this run. Check the camp again before continuing.</p><button type="button" @onclick="LoadStateAsync">Check camp</button></div>
            }
            else
            {
                <ul class="camp-heroes">
                    @foreach (var hero in camp.Heroes)
                    {
                        var fallen = hero.CurrentHP <= 0;
                        var hpPercent = hero.MaxHP <= 0 ? 0 : (int)Math.Clamp((double)hero.CurrentHP / hero.MaxHP * 100, 0, 100);
                        <li class="camp-hero @(fallen ? "is-fallen" : "")" @key="hero.HeroId">
                            <div class="camp-hero-heading">
                                <strong>@hero.Name</strong>
                                <span class="hero-status">@(fallen ? "Fallen" : "Standing")</span>
                            </div>
                            <div class="hp-heading"><span>Health</span><strong>@hero.CurrentHP / @hero.MaxHP HP</strong></div>
                            <progress value="@hpPercent" max="100" aria-label="@hero.Name health: @hero.CurrentHP of @hero.MaxHP HP"></progress>
                        </li>
                    }
                </ul>
            }

            <div class="camp-actions">
                <div>
                    <h3>Continue the expedition</h3>
                    <p>Enter stage @(camp.CurrentStageIndex + 1) in the Arena@(camp.IsBossNode ? " · Boss stage" : "").</p>
                </div>
                @if (_isProcessing)
                {
                    <p class="action-feedback" role="status">@(_stageRecoveryRequired ? "Checking active combat..." : "Processing expedition...")</p>
                }
                else if (_campMessage is not null)
                {
                    <div class="action-feedback state-error" role="alert">
                        <p>@_campMessage</p>
                        @if (_stageRecoveryRequired)
                        {
                            <button type="button" @onclick="RecoverStageAsync">Check active combat</button>
                        }
                        else if (_forfeitRecoveryRequired)
                        {
                            <button type="button" @onclick="LoadStateAsync">Check camp status</button>
                        }
                    </div>
                }
                <button class="primary-action" type="button" disabled="@(_isProcessing || _stageRecoveryRequired || camp.Heroes.Count == 0 || CombatService.IsConnecting)" @onclick="EnterStageAsync">Enter stage</button>
            </div>

            <div class="abandon-section">
                <div>
                    <h3>Leave this run</h3>
                    <p>Abandoning ends this expedition and loses its progress.</p>
                </div>
                <button class="danger-action" type="button" @ref="_abandonButton" disabled="@(_isProcessing || _forfeitRecoveryRequired)" @onclick="PromptForfeit">Abandon expedition</button>
            </div>
        </section>
    }
    else
    {
        <section class="dungeons-section" aria-labelledby="dungeons-title">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">01 / Choose your route</p>
                    <h2 id="dungeons-title">Dungeon board</h2>
                    <p>Check the guild level needed and your previous completions.</p>
                </div>
                @if (_availableDungeons is not null)
                {
                    <span class="section-count">@_availableDungeons.Count @(_availableDungeons.Count == 1 ? "dungeon" : "dungeons")</span>
                }
            </div>
            @if (_dungeonsLoading)
            {
                <p class="state-panel" role="status">Loading dungeons and guild level...</p>
            }
            else if (_dungeonsError)
            {
                <div class="state-panel state-error" role="alert">
                    <h3>Dungeons unavailable</h3>
                    <p>We couldn't load the dungeon board or your guild level.</p>
                    <button type="button" @onclick="LoadDungeonsAsync">Retry dungeons</button>
                </div>
            }
            else if (_availableDungeons is { Count: 0 })
            {
                <div class="state-panel">
                    <h3>No dungeons right now</h3>
                    <p>There are no expeditions on the board yet. Check again later.</p>
                    <button type="button" @onclick="LoadDungeonsAsync">Check again</button>
                </div>
            }
            else if (_availableDungeons is not null && _guildProfile is not null)
            {
                <fieldset class="dungeon-choices" aria-labelledby="dungeons-title">
                    <legend class="visually-hidden">Choose one dungeon</legend>
                    @foreach (var dungeon in _availableDungeons)
                    {
                        var locked = _guildProfile.Level < dungeon.RequiredGuildLevel;
                        var selected = _selectedDungeonId == dungeon.Id;
                        var completions = _guildProfile.DungeonCompletions.GetValueOrDefault(dungeon.Id);
                        <label class="dungeon-choice @(selected ? "is-selected" : "") @(locked ? "is-locked" : "")" @key="dungeon.Id">
                            <input type="radio" name="dungeon" value="@dungeon.Id" checked="@selected" disabled="@(locked || _isProcessing || _startRecoveryRequired)" @onchange="() => SelectDungeon(dungeon.Id)" />
                            <span class="choice-content">
                                <span class="choice-heading"><strong>@dungeon.Name</strong><span class="choice-status">@(locked ? "Locked" : selected ? "Selected" : "Available")</span></span>
                                @if (!string.IsNullOrWhiteSpace(dungeon.Description))
                                {
                                    <span class="choice-description">@dungeon.Description</span>
                                }
                                <span class="choice-meta">
                                    <span>Guild level @dungeon.RequiredGuildLevel required@(locked ? $" · Your level: {_guildProfile.Level}" : "")</span>
                                    <span>@completions @((completions == 1) ? "completion" : "completions")</span>
                                </span>
                            </span>
                        </label>
                    }
                </fieldset>
            }
        </section>

        <section class="dungeons-section" aria-labelledby="team-title">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">02 / Prepare your expedition</p>
                    <h2 id="team-title">Draft your team</h2>
                    <p>Select exactly three heroes. Select one again to remove them.</p>
                </div>
                <span class="section-count" aria-live="polite">@_selectedHeroIds.Count / 3 selected</span>
            </div>
            @if (_rosterLoading)
            {
                <p class="state-panel" role="status">Loading your roster...</p>
            }
            else if (_rosterError)
            {
                <div class="state-panel state-error" role="alert">
                    <h3>Roster unavailable</h3>
                    <p>We couldn't load your heroes.</p>
                    <button type="button" @onclick="LoadRosterAsync">Retry roster</button>
                </div>
            }
            else if (_heroes is { Count: 0 })
            {
                <div class="state-panel">
                    <h3>No heroes in your roster</h3>
                    <p>You need three heroes to start an expedition.</p>
                    <a href="/tavern">Explore the Tavern <span aria-hidden="true">→</span></a>
                </div>
            }
            else if (_heroes is not null)
            {
                <fieldset class="hero-choices" aria-labelledby="team-title">
                    <legend class="visually-hidden">Choose three heroes</legend>
                    @foreach (var hero in _heroes)
                    {
                        var selected = _selectedHeroIds.Contains(hero.Id);
                        <label class="hero-choice @(selected ? "is-selected" : "")" @key="hero.Id">
                            <input type="checkbox" checked="@selected" disabled="@(_isProcessing || _startRecoveryRequired || (!selected && _selectedHeroIds.Count == 3))" @onchange="() => ToggleHeroSelection(hero.Id)" />
                            <img src="@AssetService.GetPortraitUrl(hero.DefinitionId)" alt="" loading="lazy" />
                            <span class="hero-details"><strong>@hero.Name</strong><span>Level @hero.CurrentLevel</span><span class="hero-status">@(selected ? "On team" : _selectedHeroIds.Count == 3 ? "Team full" : "Select hero")</span></span>
                        </label>
                    }
                </fieldset>
            }

            <div class="team-summary">
                <h3>Team slots</h3>
                <ol class="team-slots">
                    @for (var slot = 0; slot < 3; slot++)
                    {
                        var hero = slot < _selectedHeroIds.Count ? _heroes?.FirstOrDefault(h => h.Id == _selectedHeroIds[slot]) : null;
                        <li class="team-slot @(hero is null ? "slot-empty" : "")">
                            <span class="slot-number">@(slot + 1)</span>
                            @if (hero is null)
                            {
                                <span>Open slot</span>
                            }
                            else
                            {
                                <span class="slot-hero"><strong>@hero.Name</strong><small>Level @hero.CurrentLevel</small></span>
                                <button type="button" disabled="@(_isProcessing || _startRecoveryRequired)" aria-label="Remove @hero.Name from team" @onclick="() => ToggleHeroSelection(hero.Id)">Remove</button>
                            }
                        </li>
                    }
                </ol>
            </div>

            <div class="launch-action">
                <div>
                    <h3>Begin expedition</h3>
                    <p>@(SelectedDungeon is null ? "Choose an available dungeon." : $"Dungeon: {SelectedDungeon.Name}.") @_selectedHeroIds.Count / 3 heroes selected.</p>
                </div>
                @if (_isProcessing)
                {
                    <p class="action-feedback" role="status">@(_startRecoveryRequired ? "Checking expedition status..." : "Starting expedition...")</p>
                }
                else if (_startMessage is not null)
                {
                    <div class="action-feedback state-error" role="alert">
                        <p>@_startMessage</p>
                        @if (_startRecoveryRequired)
                        {
                            <button type="button" @onclick="LoadStateAsync">Check expedition status</button>
                        }
                    </div>
                }
                <button class="primary-action" type="button" disabled="@(!CanStartDungeon)" @onclick="StartDungeonAsync">Embark</button>
            </div>
        </section>
    }
</div>

@if (_showForfeitModal)
{
    <div class="modal-backdrop">
        <div class="forfeit-dialog" role="dialog" aria-modal="true" aria-labelledby="forfeit-title" aria-describedby="forfeit-description" @onkeydown="HandleDialogKeyDown">
            <h2 id="forfeit-title">Abandon expedition?</h2>
            <p id="forfeit-description">This ends your run in @_activeCamp?.DungeonName and loses its progress.</p>
            <div class="dialog-actions">
                <button type="button" @ref="_cancelButton" @onclick="CloseForfeitAsync">Keep expedition</button>
                <button class="danger-action" type="button" @onclick="ConfirmForfeitAsync">Yes, abandon</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _campLoading = true, _campError, _dungeonsLoading, _dungeonsError, _rosterLoading, _rosterError;
    private bool _isProcessing, _showForfeitModal, _startRecoveryRequired, _stageRecoveryRequired, _forfeitRecoveryRequired, _focusDialog;
    private string? _startMessage, _campMessage, _selectedDungeonId;
    private List<DungeonSummaryDto>? _availableDungeons;
    private ActiveDungeonCampDto? _activeCamp;
    private List<HeroDto>? _heroes;
    private GuildProfileDto? _guildProfile;
    private readonly List<int> _selectedHeroIds = new();
    private ElementReference _cancelButton, _abandonButton;
    private DungeonSummaryDto? SelectedDungeon => _availableDungeons?.FirstOrDefault(d => d.Id == _selectedDungeonId);
    private bool CanStartDungeon => SelectedDungeon is { } dungeon && _guildProfile is not null
        && _guildProfile.Level >= dungeon.RequiredGuildLevel && _heroes is not null
        && _selectedHeroIds.Count == 3 && !_isProcessing && !_startRecoveryRequired;

    protected override async Task OnInitializedAsync() => await LoadStateAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDialog && _showForfeitModal)
        {
            _focusDialog = false;
            await _cancelButton.FocusAsync();
        }
    }

    private async Task LoadStateAsync()
    {
        _campLoading = true;
        _campError = false;
        _activeCamp = null;
        try
        {
            using var response = await Http.GetAsync("api/dungeon/camp");
            if (response.IsSuccessStatusCode)
            {
                _activeCamp = await response.Content.ReadFromJsonAsync<ActiveDungeonCampDto>()
                    ?? throw new JsonException("Empty camp response");
                _startRecoveryRequired = false;
                _startMessage = null;
                _forfeitRecoveryRequired = false;
            }
            else if (response.StatusCode != HttpStatusCode.NotFound || await GetErrorCodeAsync(response) != "Dungeon.NoActiveRun")
            {
                _campError = true;
            }
            else
            {
                _startRecoveryRequired = false;
                _startMessage = null;
                _forfeitRecoveryRequired = false;
            }
        }
        catch (Exception)
        {
            _campError = true;
        }
        finally
        {
            _campLoading = false;
        }

        if (!_campError && _activeCamp is null)
            await Task.WhenAll(LoadDungeonsAsync(), LoadRosterAsync());
        else if (!_campError)
            _campMessage = null;
    }

    private async Task LoadDungeonsAsync()
    {
        _dungeonsLoading = true;
        _dungeonsError = false;
        _availableDungeons = null;
        _guildProfile = null;
        _selectedDungeonId = null;
        try
        {
            var dungeonsTask = Http.GetFromJsonAsync<List<DungeonSummaryDto>>("api/dungeon");
            var profileTask = Http.GetFromJsonAsync<GuildProfileDto>("api/guild/profile");
            await Task.WhenAll(dungeonsTask, profileTask);
            _availableDungeons = await dungeonsTask;
            _guildProfile = await profileTask;
            _dungeonsError = _availableDungeons is null || _guildProfile is null;
        }
        catch (Exception) { _dungeonsError = true; }
        finally { _dungeonsLoading = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadRosterAsync()
    {
        _rosterLoading = true;
        _rosterError = false;
        _heroes = null;
        _selectedHeroIds.Clear();
        try
        {
            _heroes = await Http.GetFromJsonAsync<List<HeroDto>>("api/guild/my-roster");
            _rosterError = _heroes is null;
        }
        catch (Exception) { _rosterError = true; }
        finally { _rosterLoading = false; await InvokeAsync(StateHasChanged); }
    }

    private void SelectDungeon(string dungeonId) => _selectedDungeonId = dungeonId;

    private void ToggleHeroSelection(int heroId)
    {
        if (_selectedHeroIds.Contains(heroId)) _selectedHeroIds.Remove(heroId);
        else if (_heroes?.Any(h => h.Id == heroId) == true && _selectedHeroIds.Count < 3) _selectedHeroIds.Add(heroId);
    }

    private async Task StartDungeonAsync()
    {
        if (!CanStartDungeon) return;
        _isProcessing = true;
        _startMessage = null;
        _startRecoveryRequired = true;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/dungeon/start", new StartDungeonRequest
            {
                DungeonId = _selectedDungeonId!, HeroInstanceIds = new List<int>(_selectedHeroIds)
            });
            var failure = response.IsSuccessStatusCode ? null : await GetErrorDetailAsync(response);
            await LoadStateAsync();
            if (!_campError && _activeCamp is null)
            {
                _startRecoveryRequired = response.IsSuccessStatusCode;
                _startMessage = response.IsSuccessStatusCode
                    ? "The start request succeeded, but camp could not be confirmed. Check expedition status before trying again."
                    : $"{failure ?? "The server did not start this expedition."} Review your team and try again.";
            }
        }
        catch (Exception)
        {
            await LoadStateAsync();
            if (_activeCamp is null)
            {
                _startRecoveryRequired = _campError;
                _startMessage = _campError
                    ? "We couldn't confirm whether the expedition started. Check expedition status before trying again."
                    : "No active expedition was found. Review your team and try again.";
            }
        }
        finally { _isProcessing = false; }
    }

    private void PromptForfeit() { _showForfeitModal = true; _focusDialog = true; }
    private async Task CloseForfeitAsync()
    {
        _showForfeitModal = false;
        await _abandonButton.FocusAsync();
    }
    private async Task HandleDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseForfeitAsync();
    }

    private async Task ConfirmForfeitAsync()
    {
        if (_isProcessing) return;
        _showForfeitModal = false;
        _isProcessing = true;
        _campMessage = null;
        _forfeitRecoveryRequired = true;
        try
        {
            using var response = await Http.PostAsync("api/dungeon/forfeit", null);
            if (response.IsSuccessStatusCode)
            {
                await LoadStateAsync();
                if (_activeCamp is not null) _campMessage = "The run still appears active. Check camp status before trying again.";
            }
            else
            {
                _forfeitRecoveryRequired = false;
                _campMessage = await GetErrorDetailAsync(response) ?? "We couldn't abandon the expedition. Your run is still at camp; try again.";
            }
        }
        catch (Exception)
        {
            _campMessage = "We couldn't confirm whether the run was abandoned. Check camp status before trying again.";
        }
        finally { _isProcessing = false; }
    }

    private async Task EnterStageAsync()
    {
        if (_isProcessing || _stageRecoveryRequired || _activeCamp is null) return;
        _isProcessing = true;
        _campMessage = null;
        try
        {
            var result = await CombatService.EnterDungeonCombatAsync();
            if (result == EncounterStartResult.Ready)
            {
                NavManager.NavigateTo("/arena");
                return;
            }
            _stageRecoveryRequired = true;
            _campMessage = "We couldn't confirm combat entry. Checking for an active combat before trying again.";
            await RecoverStageAsync();
        }
        finally { _isProcessing = false; }
    }

    private async Task RecoverStageAsync()
    {
        _isProcessing = true;
        try
        {
            var active = await CombatService.CheckActiveCombatAsync();
            if (active is null)
                _campMessage = "We couldn't check for active combat. Check your connection and try again before entering the stage.";
            else if (active.HasActiveCombat)
            {
                if (await CombatService.RejoinCombatAsync(active.CombatId!))
                {
                    NavManager.NavigateTo("/arena");
                    return;
                }
                _campMessage = "Combat is active, but we couldn't connect to the Arena. Check your connection and try again.";
            }
            else
            {
                _stageRecoveryRequired = false;
                _campMessage = "No active combat was found. You can try entering the stage again.";
            }
        }
        finally { _isProcessing = false; }
    }

    private static async Task<string?> GetErrorCodeAsync(HttpResponseMessage response)
    {
        try
        {
            using var json = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
            return json.RootElement.TryGetProperty("code", out var code) ? code.GetString() : null;
        }
        catch (JsonException) { return null; }
    }

    private static async Task<string?> GetErrorDetailAsync(HttpResponseMessage response)
    {
        try
        {
            using var json = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
            return json.RootElement.TryGetProperty("detail", out var detail) && detail.ValueKind == JsonValueKind.String ? detail.GetString() : null;
        }
        catch (JsonException) { return null; }
    }
}
