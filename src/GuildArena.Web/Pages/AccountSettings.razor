@page "/account"
@attribute [Authorize]
@using GuildArena.Shared.Requests
@using GuildArena.Shared.DTOs.Identity
@using GuildArena.Web.Security
@inject HttpClient Http
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthState

<PageTitle>Account settings | GuildArena</PageTitle>

<div class="auth-page account-page">
    <header class="auth-intro">
        <p class="auth-eyebrow">Your account</p>
        <h1>Account settings</h1>
        <p>Manage your email verification and password.</p>
    </header>

    <section class="auth-card account-section" aria-labelledby="email-title">
        <h2 id="email-title">Email & verification</h2>
        @if (_isLoadingInfo)
        {
            <p role="status">Loading your account details...</p>
        }
        else if (_infoError)
        {
            <div class="auth-feedback error" role="alert">We couldn't load your account details.</div>
            <button type="button" class="auth-secondary" @onclick="LoadUserInfoAsync">Retry</button>
        }
        else if (_userInfo is not null)
        {
            <p class="account-email">@_userInfo.Email</p>
            @if (_userInfo.IsEmailConfirmed)
            {
                <p class="account-verified">Email confirmed</p>
            }
            else
            {
                <p class="account-unverified">Email not confirmed</p>
                <p>Confirm your email to enable password recovery. Check your inbox or request another link.</p>
                <button type="button" class="auth-secondary" @onclick="ResendVerificationEmailAsync" disabled="@_isResendingEmail">@(_isResendingEmail ? "Requesting link..." : "Resend confirmation link")</button>
                @if (_isResendingEmail)
                {
                    <p class="auth-hint" role="status">Requesting a confirmation link...</p>
                }
                @if (_resendMessage is not null)
                {
                    <div class="auth-feedback @(_resendError ? "error" : "success") account-message" role="@(_resendError ? "alert" : "status")">@_resendMessage</div>
                }
            }
        }
    </section>

    <section class="auth-card account-section" aria-labelledby="password-title">
        <h2 id="password-title">Change password</h2>
        <p>Use your current password to set a new one.</p>
        <form @onsubmit="ChangePasswordAsync" @onsubmit:preventDefault="true">
            @if (_passwordSuccess)
            {
                <div class="auth-feedback success" role="status">Your password was updated.</div>
            }
            @if (_passwordError is not null)
            {
                <div class="auth-feedback error" role="alert">@_passwordError</div>
            }
            <div class="auth-field">
                <label for="current-password">Current password</label>
                <input id="current-password" name="currentPassword" type="password" autocomplete="current-password" @bind="_currentPassword" required disabled="@_isProcessingPassword" />
            </div>
            <div class="auth-field">
                <label for="new-account-password">New password</label>
                <input id="new-account-password" name="newPassword" type="password" autocomplete="new-password" @bind="_newPassword" required aria-describedby="account-password-help" disabled="@_isProcessingPassword" />
                <p id="account-password-help" class="auth-hint">Choose a strong, unique password. Password requirements are checked when you submit.</p>
            </div>
            <div class="auth-field">
                <label for="confirm-account-password">Confirm new password</label>
                <input id="confirm-account-password" name="confirmPassword" type="password" autocomplete="new-password" @bind="_confirmNewPassword" required disabled="@_isProcessingPassword" />
            </div>
            <button type="submit" class="auth-action" disabled="@_isProcessingPassword">@(_isProcessingPassword ? "Updating..." : "Update password")</button>
            @if (_isProcessingPassword)
            {
                <p class="auth-hint" role="status">Updating your password...</p>
            }
        </form>
    </section>

    <section class="auth-card account-section account-danger" aria-labelledby="delete-title">
        <h2 id="delete-title">Delete account</h2>
        <p>Deletion is permanent. Your guild, heroes, and progress will be removed.</p>
        <button type="button" class="account-delete" @ref="_openDeleteButton" @onclick="OpenDeleteDialog">Delete account...</button>
    </section>
</div>

@if (_showDeleteModal)
{
    <div class="account-backdrop" @onclick="CloseDeleteDialog">
        <div class="account-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-dialog-title" aria-describedby="delete-dialog-description" @onclick:stopPropagation="true" @onkeydown="HandleDialogKeyDown">
            <span class="dialog-focus-guard" tabindex="0" @onfocus="FocusLastDialogControlAsync"></span>
            <h2 id="delete-dialog-title">Permanently delete account?</h2>
            <p id="delete-dialog-description">Your guild, heroes, and progress cannot be restored. Enter your current password to confirm.</p>
            <form @onsubmit="DeleteAccountAsync" @onsubmit:preventDefault="true">
                @if (_deleteError is not null)
                {
                    <div class="auth-feedback error" role="alert">@_deleteError</div>
                }
                <div class="auth-field">
                    <label for="delete-password">Current password</label>
                    <input id="delete-password" name="deletePassword" type="password" autocomplete="current-password" @bind="_deleteConfirmPassword" required disabled="@_isDeleting" />
                </div>
                <div class="account-dialog-actions">
                    <button type="button" class="auth-secondary" @ref="_cancelDeleteButton" @onclick="CloseDeleteDialog" disabled="@_isDeleting">Cancel</button>
                    <button type="submit" class="account-delete" @ref="_confirmDeleteButton" disabled="@_isDeleting">@(_isDeleting ? "Deleting..." : "Permanently delete")</button>
                </div>
                @if (_isDeleting)
                {
                    <p class="auth-hint" role="status">Deleting your account...</p>
                }
            </form>
            <span class="dialog-focus-guard" tabindex="0" @onfocus="FocusFirstDialogControlAsync"></span>
        </div>
    </div>
}

@code {
    private UserInfoDto? _userInfo;
    private bool _isLoadingInfo = true;
    private bool _infoError;
    private bool _isResendingEmail;
    private bool _resendError;
    private string? _resendMessage;
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmNewPassword = "";
    private bool _isProcessingPassword;
    private bool _passwordSuccess;
    private string? _passwordError;
    private bool _showDeleteModal;
    private bool _focusDeleteDialog;
    private ElementReference _cancelDeleteButton;
    private ElementReference _confirmDeleteButton;
    private ElementReference _openDeleteButton;
    private string _deleteConfirmPassword = "";
    private bool _isDeleting;
    private string? _deleteError;

    protected override Task OnInitializedAsync() => LoadUserInfoAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDeleteDialog)
        {
            _focusDeleteDialog = false;
            await _cancelDeleteButton.FocusAsync();
        }
    }

    private async Task LoadUserInfoAsync()
    {
        _isLoadingInfo = true;
        _infoError = false;
        _userInfo = null;
        try
        {
            _userInfo = await Http.GetFromJsonAsync<UserInfoDto>("api/account/me");
            _infoError = _userInfo is null;
        }
        catch
        {
            _infoError = true;
        }
        finally
        {
            _isLoadingInfo = false;
        }
    }

    private async Task ResendVerificationEmailAsync()
    {
        if (_userInfo is null) return;
        _isResendingEmail = true;
        _resendMessage = null;
        try
        {
            var response = await Http.PostAsJsonAsync("resendConfirmationEmail", new ResendConfirmationEmailRequest { Email = _userInfo.Email });
            _resendError = !response.IsSuccessStatusCode;
            _resendMessage = _resendError ? "We couldn't request a link right now. Try again later." : "If your email still needs confirmation, a new link will be sent. Check your inbox.";
        }
        catch
        {
            _resendError = true;
            _resendMessage = "Connection unavailable. Please try again.";
        }
        finally
        {
            _isResendingEmail = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        _passwordError = null;
        _passwordSuccess = false;
        if (_newPassword != _confirmNewPassword)
        {
            _passwordError = "The new passwords do not match.";
            return;
        }

        _isProcessingPassword = true;
        try
        {
            var response = await Http.PostAsJsonAsync("manage/info", new { oldPassword = _currentPassword, newPassword = _newPassword });
            if (response.IsSuccessStatusCode)
            {
                _passwordSuccess = true;
                _currentPassword = _newPassword = _confirmNewPassword = "";
            }
            else
            {
                _passwordError = "We couldn't update your password. Check your current password and the new password requirements.";
            }
        }
        catch
        {
            _passwordError = "Connection unavailable. Please try again.";
        }
        finally
        {
            _isProcessingPassword = false;
        }
    }

    private void OpenDeleteDialog()
    {
        _deleteError = null;
        _deleteConfirmPassword = "";
        _showDeleteModal = true;
        _focusDeleteDialog = true;
    }

    private async Task CloseDeleteDialog()
    {
        if (_isDeleting) return;
        _showDeleteModal = false;
        _deleteConfirmPassword = "";
        _deleteError = null;
        await _openDeleteButton.FocusAsync(preventScroll: true);
    }

    private Task FocusFirstDialogControlAsync() => _cancelDeleteButton.FocusAsync().AsTask();
    private Task FocusLastDialogControlAsync() => _confirmDeleteButton.FocusAsync().AsTask();

    private async Task HandleDialogKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") await CloseDeleteDialog();
    }

    private async Task DeleteAccountAsync()
    {
        _deleteError = null;
        _isDeleting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/account/delete", new DeleteAccountRequest { Password = _deleteConfirmPassword });
            if (response.IsSuccessStatusCode)
            {
                ((CookieAuthenticationStateProvider)AuthState).NotifyAuthStatusChanged();
                NavManager.NavigateTo("/login");
            }
            else
            {
                _deleteError = "We couldn't delete your account. Check your password and try again.";
            }
        }
        catch
        {
            _deleteError = "Connection unavailable. Please try again.";
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
