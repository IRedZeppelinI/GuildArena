@page "/login"
@using GuildArena.Shared.Requests
@using GuildArena.Web.Security
@inject HttpClient Http
@inject AuthenticationStateProvider AuthState
@inject NavigationManager NavManager

<PageTitle>Sign in | GuildArena</PageTitle>

<div class="auth-page">
    <header class="auth-intro">
        <p class="auth-eyebrow">Your guild awaits</p>
        <h1>Sign in</h1>
        <p>Return to your roster and continue your journey.</p>
    </header>
    <section class="auth-card" aria-label="Sign in to your account">
        <form @onsubmit="ExecuteLogin" @onsubmit:preventDefault="true">
            @if (_errorMessage is not null)
            {
                <div class="auth-feedback error" role="alert">@_errorMessage</div>
            }
            <div class="auth-field">
                <label for="login-email">Email address</label>
                <input id="login-email" name="email" type="email" autocomplete="username" @bind="_request.Email" required disabled="@_isLoading" />
            </div>
            <div class="auth-field">
                <label for="login-password">Password</label>
                <input id="login-password" name="password" type="password" autocomplete="current-password" @bind="_request.Password" required disabled="@_isLoading" />
                <p class="auth-hint"><a href="/forgot-password">Forgot your password?</a></p>
            </div>
            <button type="submit" class="auth-action auth-wide" disabled="@_isLoading">@(_isLoading ? "Signing in..." : "Sign in")</button>
            @if (_isLoading)
            {
                <p class="auth-hint" role="status">Checking your credentials...</p>
            }
        </form>
        <div class="auth-footer">New to GuildArena? <a href="/register">Create an account</a></div>
    </section>
</div>

@code {
    private LoginRequest _request = new() { Email = string.Empty, Password = string.Empty };
    private string? _errorMessage;
    private bool _isLoading;

    private async Task ExecuteLogin()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var response = await Http.PostAsJsonAsync("login?useCookies=true", _request);
            if (response.IsSuccessStatusCode)
            {
                ((CookieAuthenticationStateProvider)AuthState).NotifyAuthStatusChanged();
                NavManager.NavigateTo("/guild");
            }
            else
            {
                _errorMessage = "We couldn't sign you in. Check your email and password, then try again.";
            }
        }
        catch
        {
            _errorMessage = "Connection unavailable. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
