@page "/quests"
@attribute [Authorize]
@using GuildArena.Shared.DTOs.Quests
@using GuildArena.Web.Components
@using System.Text.Json
@inject HttpClient Http

<PageTitle>Daily Bounties</PageTitle>

<div class="quests-page">
    <header class="quests-header">
        <p class="quests-eyebrow">Guild register / Daily objectives</p>
        <h1>Daily Bounties</h1>
        <p>Follow your objectives and earn gold and guild XP when you complete them. Rewards are granted automatically.</p>
    </header>

    @if (_isRerolling)
    {
        <p class="quests-feedback" role="status">Rerolling your bounty and updating the board...</p>
    }
    @if (_rerollMessage is not null)
    {
        <p class="quests-feedback" role="status">@_rerollMessage</p>
    }

    @if (_isLoading)
    {
        <p class="quests-state" role="status">Consulting the bounty board...</p>
    }
    else if (_loadError)
    {
        <section class="quests-state quests-state-error" role="alert">
            <h2>Bounties unavailable</h2>
            <p>We couldn't load your bounties. Try again to see your current objectives.</p>
            <button type="button" @onclick="LoadQuestsAsync">Try again</button>
        </section>
    }
    else if (_quests is { Count: 0 })
    {
        <section class="quests-state">
            <h2>No bounties right now</h2>
            <p>There are no objectives on the board yet. Check again later.</p>
            <button type="button" @onclick="LoadQuestsAsync">Check again</button>
        </section>
    }
    else if (_quests is not null)
    {
        <section class="quests-board" aria-labelledby="quests-board-title">
            <div class="quests-board-heading">
                <div>
                    <p class="quests-eyebrow">Today's board</p>
                    <h2 id="quests-board-title">Your objectives</h2>
                    <p>Complete bounties through your guild's activities. You can reroll one unfinished bounty per day. If you've already used it, you'll be told here.</p>
                </div>
                <span class="quests-count">@_quests.Count(q => q.IsCompleted) / @_quests.Count completed</span>
            </div>

            @if (_rerollNeedsRefresh)
            {
                <div class="quests-feedback quests-feedback-warning" role="alert">
                    <p>We couldn't confirm whether the reroll went through. Refresh the board before trying again.</p>
                    <button type="button" @onclick="LoadQuestsAsync">Refresh board</button>
                </div>
            }
            else if (_rerollUsedToday)
            {
                <p class="quests-feedback" role="status">Your daily reroll has been used. New bounties can still be completed.</p>
            }

            <div class="quests-list">
                @foreach (var quest in _quests)
                {
                    var target = Math.Max(quest.TargetValue, 1);
                    <article class="quest-card @(quest.IsCompleted ? "quest-completed" : "")" @key="quest.Id">
                        <div class="quest-main">
                            <div class="quest-heading">
                                <div>
                                    <p class="quests-eyebrow">@(quest.IsCompleted ? "Bounty fulfilled" : "Active bounty")</p>
                                    <h3>@quest.Name</h3>
                                </div>
                                <span class="quest-status">@(quest.IsCompleted ? "Completed" : "In progress")</span>
                            </div>
                            <p class="quest-description">@quest.Description</p>
                            <div class="quest-progress">
                                <div class="quest-progress-label">
                                    <strong>Objective progress</strong>
                                    <span>@quest.CurrentProgress / @quest.TargetValue</span>
                                </div>
                                <progress value="@Math.Clamp(quest.CurrentProgress, 0, target)" max="@target" aria-label="@quest.Name progress: @quest.CurrentProgress of @quest.TargetValue"></progress>
                            </div>
                        </div>

                        <div class="quest-aside">
                            <div class="quest-rewards">
                                <h4>Rewards</h4>
                                <p><span>Gold</span><strong><GoldAmount Value="quest.RewardGold" /></strong></p>
                                <p><span>Guild XP</span><strong>@quest.RewardXP XP</strong></p>
                            </div>
                            @if (_feedbackQuestId == quest.Id && _rerollError is not null)
                            {
                                <p class="quest-error" role="alert">@_rerollError</p>
                            }
                            @if (quest.IsCompleted)
                            {
                                <p class="quest-completion">Completed · rewards granted automatically</p>
                            }
                            else
                            {
                                <button type="button" class="quest-reroll" disabled="@(_isRerolling || _rerollUsedToday || _rerollNeedsRefresh)"
                                        @onclick="() => RerollQuestAsync(quest.Id)">
                                    @(_rerollingQuestId == quest.Id ? "Rerolling..." : _rerollUsedToday ? "Reroll used today" : "Reroll bounty")
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>

@code {
    private List<QuestDto>? _quests;
    private bool _isLoading = true;
    private bool _loadError;
    private bool _isRerolling;
    private bool _rerollUsedToday;
    private bool _rerollNeedsRefresh;
    private int? _rerollingQuestId;
    private int? _feedbackQuestId;
    private string? _rerollError;
    private string? _rerollMessage;

    protected override async Task OnInitializedAsync() => await LoadQuestsAsync();

    private async Task LoadQuestsAsync()
    {
        _isLoading = true;
        _loadError = false;
        _quests = null;

        try
        {
            var quests = await Http.GetFromJsonAsync<List<QuestDto>>("api/quest");
            _quests = quests?.OrderBy(q => q.IsCompleted).ThenBy(q => q.Id).ToList();
            _loadError = _quests is null;
            if (!_loadError)
            {
                _rerollNeedsRefresh = false;
                _feedbackQuestId = null;
                _rerollError = null;
            }
        }
        catch (Exception)
        {
            _loadError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RerollQuestAsync(int questId)
    {
        if (_isRerolling || _rerollUsedToday || _rerollNeedsRefresh ||
            _quests?.Any(q => q.Id == questId && !q.IsCompleted) != true) return;

        _isRerolling = true;
        _rerollingQuestId = questId;
        _feedbackQuestId = null;
        _rerollError = null;
        _rerollMessage = null;
        try
        {
            using var response = await Http.PostAsync($"api/quest/{questId}/reroll", null);
            if (response.IsSuccessStatusCode)
            {
                _rerollUsedToday = true;
                _rerollMessage = "Bounty rerolled. Your new objective is on the board.";
                await LoadQuestsAsync();
                if (_loadError)
                {
                    _rerollMessage = "Bounty rerolled, but the board couldn't refresh. Try loading it again.";
                }
            }
            else
            {
                _feedbackQuestId = questId;
                var code = await ReadErrorCodeAsync(response);
                _rerollError = code switch
                {
                    "Quests.RerollUsed" => "Your daily reroll has already been used. Come back tomorrow for another.",
                    "Quests.NoValidPool" => "There are no other bounties available for your guild right now.",
                    "Quests.AlreadyCompleted" => "This bounty has already been completed. Refresh the board to see your latest progress.",
                    "Quests.NotFound" => "This bounty is no longer on the board. Refresh to see your current objectives.",
                    _ => "The server couldn't reroll this bounty. Please try again or refresh the board."
                };
                if (code == "Quests.RerollUsed") _rerollUsedToday = true;
            }
        }
        catch (Exception)
        {
            _rerollNeedsRefresh = true;
        }
        finally
        {
            _isRerolling = false;
            _rerollingQuestId = null;
        }
    }

    private static async Task<string?> ReadErrorCodeAsync(HttpResponseMessage response)
    {
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<JsonElement>();
            return problem.TryGetProperty("code", out var code) ? code.GetString() : null;
        }
        catch (Exception)
        {
            return null;
        }
    }
}
