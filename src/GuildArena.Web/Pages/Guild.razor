@page "/guild"
@attribute [Authorize]
@using GuildArena.Shared.Requests
@using GuildArena.Shared.DTOs.GuildAndHeroes
@using GuildArena.Web.Security
@using System.Security.Claims
@inject HttpClient Http
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthState
@inject GuildArena.Web.Services.IAssetService AssetService

<PageTitle>@(_isCheckingState || _hasGuild ? "Guild Profile" : "Create Guild")</PageTitle>

<div class="guild-page">
    @if (_isCheckingState)
    {
        <p class="guild-feedback" role="status">Checking your guild...</p>
    }
    else if (!_hasGuild)
    {
        <div class="guild-creation">
            <div class="creation-intro">
                <div class="creation-mark" aria-hidden="true">
                    <img src="/images/ui/estandarte.svg" alt="" width="44" height="44" />
                </div>
                <p class="creation-eyebrow">Your first chapter</p>
                <h1>Every roster starts with a name.</h1>
                <p class="creation-description">Found your guild and meet your starter heroes. Your roster will be ready to explore as soon as your guild is created.</p>
                <div class="creation-next">
                    <span class="creation-next-number" aria-hidden="true">01 / 02</span>
                    <span>Name your guild <span aria-hidden="true">→</span> Meet your roster</span>
                </div>
            </div>

            <section class="creation-panel" aria-labelledby="creation-title">
                <p class="creation-eyebrow">Guild register</p>
                <h2 id="creation-title">Found your guild</h2>
                <p class="creation-panel-description">Choose a name to represent your heroes.</p>

                <form @onsubmit="CreateGuildAsync" @onsubmit:preventDefault="true">
                    <div class="creation-field">
                        <label for="guild-name">Guild name</label>
                        <input id="guild-name" name="guildName" type="text" @bind="_guildName" @bind:event="oninput" @bind:after="ClearNameError"
                               placeholder="e.g. Knights of Cydonia" required minlength="3" aria-describedby="guild-name-help"
                               aria-invalid="@(_isNameInvalid ? "true" : null)" disabled="@(_isCreatingGuild || _isRedirecting)" />
                        <p id="guild-name-help">At least 3 characters.</p>
                    </div>

                    @if (_guildError is not null)
                    {
                        <div class="creation-error" role="alert">
                            <strong>Guild not created</strong>
                            <p>@_guildError</p>
                            @if (_showReload)
                            {
                                <button type="button" class="creation-recovery" @onclick="ReloadGuild">Reload guild page</button>
                            }
                            else if (_sessionExpired)
                            {
                                <a href="/login" class="creation-recovery">Sign in again</a>
                            }
                        </div>
                    }

                    <button class="creation-submit" type="submit" disabled="@(_isCreatingGuild || _isRedirecting)">
                        @(_isRedirecting ? "Opening your roster..." : _isCreatingGuild ? "Creating guild..." : "Create guild")
                        <span aria-hidden="true">→</span>
                    </button>
                    @if (_isCreatingGuild || _isRedirecting)
                    {
                        <p class="creation-status" role="status">@(_isRedirecting ? "Guild created. Opening your roster." : "Creating your guild and starter roster...")</p>
                    }
                </form>
            </section>
        </div>
    }
    else
    {
        <div class="guild-profile">
            @if (_profile is not null)
            {
                <header class="guild-identity">
                    <p class="guild-eyebrow">Guild register / Profile</p>
                    <h1>@_profile.Name</h1>
                    <p class="guild-level">Guild level @_profile.Level</p>
                </header>
                <div class="guild-overview">
                    <section class="guild-stat" aria-labelledby="xp-title">
                        <div class="guild-stat-heading">
                            <h2 id="xp-title">Level progress</h2>
                            @if (_profile.RequiredXP > 0)
                            {
                                <span class="guild-stat-value">@_profile.CurrentXP / @_profile.RequiredXP XP</span>
                            }
                        </div>
                        @if (_profile.RequiredXP > 0)
                        {
                            <progress class="guild-xp" value="@Math.Clamp(_profile.CurrentXP, 0, _profile.RequiredXP)" max="@_profile.RequiredXP" aria-label="Guild level progress: @_profile.CurrentXP of @_profile.RequiredXP XP"></progress>
                            <p>XP toward the next guild level</p>
                        }
                        else
                        {
                            <p>XP progress is unavailable.</p>
                        }
                    </section>
                    <section class="guild-stat" aria-labelledby="record-title">
                        <h2 id="record-title">Match record</h2>
                        <div class="guild-record">
                            <p><strong>@_profile.Wins</strong> <span>Wins</span></p>
                            <p><strong>@_profile.Losses</strong> <span>Losses</span></p>
                        </div>
                    </section>
                </div>
            }
            else
            {
                <div class="guild-state" role="@(_profileError ? "alert" : "status")">
                    <h1>Your guild</h1>
                    @if (_profileError)
                    {
                        <p>We couldn't load your guild profile. Your roster may still be available.</p>
                        <button type="button" @onclick="LoadProfileAsync">Retry profile</button>
                    }
                    else
                    {
                        <p>Loading guild profile...</p>
                    }
                </div>
            }

            <section class="guild-roster" aria-labelledby="roster-title">
                <div class="guild-roster-heading">
                    <div>
                        <p class="guild-eyebrow">Your collection</p>
                        <h2 id="roster-title">Collected heroes</h2>
                        <p>Explore your heroes and view their attributes.</p>
                    </div>
                    @if (_heroes is not null)
                    {
                        <span class="guild-roster-count">@_heroes.Count @(_heroes.Count == 1 ? "hero" : "heroes")</span>
                    }
                </div>

                @if (_rosterError)
                {
                    <div class="guild-state" role="alert">
                        <h3>Roster unavailable</h3>
                        <p>We couldn't load your heroes. Try again to see your collection.</p>
                        <button type="button" @onclick="LoadRosterAsync">Retry roster</button>
                    </div>
                }
                else if (_heroes is null)
                {
                    <p class="guild-feedback" role="status">Loading your roster...</p>
                }
                else if (_heroes.Count == 0)
                {
                    <div class="guild-state">
                        <h3>No heroes in your roster yet</h3>
                        <p>Visit the Tavern to discover heroes to recruit.</p>
                        <a href="/tavern">Explore the Tavern <span aria-hidden="true">→</span></a>
                    </div>
                }
                else
                {
                    <ul class="guild-hero-list">
                        @foreach (var hero in _heroes)
                        {
                            <li>
                                <a class="guild-hero" href="/hero/@hero.DefinitionId" aria-label="View @hero.Name, level @hero.CurrentLevel">
                                    <span class="guild-hero-portrait" style="background-image: url('@AssetService.GetPortraitUrl(hero.DefinitionId)')" aria-hidden="true"></span>
                                    <span class="guild-hero-info">
                                        <strong>@hero.Name</strong>
                                        <span>Hero · Level @hero.CurrentLevel</span>
                                    </span>
                                    <span class="guild-hero-action" aria-hidden="true">View hero <span>→</span></span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    }
</div>

@code {
    private bool _isCheckingState = true;
    private bool _hasGuild = false;
    private string _guildName = string.Empty;
    private bool _isCreatingGuild;
    private bool _isRedirecting;
    private bool _isNameInvalid;
    private bool _sessionExpired;
    private bool _showReload;
    private string? _guildError;

    private GuildProfileDto? _profile;
    private List<HeroDto>? _heroes;
    private bool _profileError;
    private bool _rosterError;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        _hasGuild = user.HasClaim(c => c.Type == "GuildId");
        _isCheckingState = false;

        if (_hasGuild)
        {
            await LoadGuildDataAsync();
        }
    }

    private async Task CreateGuildAsync()
    {
        if (_isCreatingGuild || _isRedirecting)
        {
            return;
        }

        _isCreatingGuild = true;
        _guildError = null;
        _isNameInvalid = false;
        _sessionExpired = false;
        _showReload = false;
        try
        {
            var request = new CreateGuildRequest { GuildName = _guildName };
            using var response = await Http.PostAsJsonAsync("api/guild/create", request);
            if (response.IsSuccessStatusCode)
            {
                _isRedirecting = true;
                var customAuthState = (CookieAuthenticationStateProvider)AuthState;
                customAuthState.NotifyAuthStatusChanged();
                NavManager.NavigateTo("/guild", forceLoad: true);
            }
            else
            {
                _guildError = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.BadRequest => "Check your guild name and try again. It must be at least 3 characters long.",
                    System.Net.HttpStatusCode.Conflict => "This account already has a guild. Reload to see your roster.",
                    System.Net.HttpStatusCode.Unauthorized => "Your session has expired. Sign in again to continue.",
                    _ => "We couldn't create your guild right now. Please try again."
                };
                _isNameInvalid = response.StatusCode == System.Net.HttpStatusCode.BadRequest;
                _showReload = response.StatusCode == System.Net.HttpStatusCode.Conflict;
                _sessionExpired = response.StatusCode == System.Net.HttpStatusCode.Unauthorized;
            }
        }
        catch (HttpRequestException)
        {
            _guildError = "Unable to connect. Check your connection and try again.";
        }
        catch (TaskCanceledException)
        {
            _guildError = "The request timed out. Please try again.";
        }
        finally
        {
            _isCreatingGuild = false;
        }
    }

    private void ClearNameError()
    {
        if (_isNameInvalid)
        {
            _guildError = null;
            _isNameInvalid = false;
        }
    }

    private void ReloadGuild() => NavManager.NavigateTo("/guild", forceLoad: true);

    private async Task LoadGuildDataAsync()
    {
        await Task.WhenAll(LoadProfileAsync(), LoadRosterAsync());
    }

    private async Task LoadProfileAsync()
    {
        _profileError = false;
        _profile = null;
        try
        {
            _profile = await Http.GetFromJsonAsync<GuildProfileDto>("api/guild/profile");
            _profileError = _profile is null;
        }
        catch (Exception)
        {
            _profileError = true;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadRosterAsync()
    {
        _rosterError = false;
        _heroes = null;
        try
        {
            _heroes = await Http.GetFromJsonAsync<List<HeroDto>>("api/guild/my-roster");
            _rosterError = _heroes is null;
        }
        catch (Exception)
        {
            _rosterError = true;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }
}
