@page "/encounters"
@attribute [Authorize]
@using GuildArena.Shared.DTOs.GuildAndHeroes
@using GuildArena.Shared.DTOs.Encounters
@using GuildArena.Web.Services
@using GuildArena.Web.State
@inject HttpClient Http
@inject IAssetService AssetService
@inject ICombatStateService CombatService
@inject NavigationManager NavManager

<PageTitle>World Encounters</PageTitle>

<div class="encounters-page">
    <header class="encounters-header">
        <p class="encounters-eyebrow">Guild register / World encounters</p>
        <h1>World Encounters</h1>
        <p>Choose an encounter, then assemble three heroes for the Arena.</p>
    </header>

    <section class="encounters-section" aria-labelledby="encounters-title">
        <div class="section-heading">
            <div>
                <p class="encounters-eyebrow">01 / Choose your challenge</p>
                <h2 id="encounters-title">Available encounters</h2>
                <p>Compare difficulty tiers and guild requirements before choosing your challenge.</p>
            </div>
            @if (_availableEncounters is not null)
            {
                <span class="section-count">@_availableEncounters.Count @(_availableEncounters.Count == 1 ? "encounter" : "encounters")</span>
            }
        </div>

        @if (_encountersLoading)
        {
            <p class="encounters-state" role="status">Checking encounters and guild level...</p>
        }
        else if (_encountersError)
        {
            <div class="encounters-state state-error" role="alert">
                <h3>Encounters unavailable</h3>
                <p>We couldn't load the encounters or your guild level. Try again to see which challenges you can enter.</p>
                <button type="button" @onclick="LoadEncountersAsync">Retry encounters</button>
            </div>
        }
        else if (_availableEncounters is { Count: 0 })
        {
            <div class="encounters-state">
                <h3>No encounters right now</h3>
                <p>There are no challenges on the board yet. Check again later.</p>
                <button type="button" @onclick="LoadEncountersAsync">Check again</button>
            </div>
        }
        else if (_availableEncounters is not null && _guildProfile is not null)
        {
            <fieldset class="encounter-choices" aria-labelledby="encounters-title">
                <legend class="visually-hidden">Choose one encounter</legend>
                @foreach (var encounter in _availableEncounters)
                {
                    var isLocked = _guildProfile.Level < encounter.RequiredGuildLevel;
                    var isSelected = _selectedEncounterId == encounter.Id;
                    <label class="encounter-choice @(isSelected ? "is-selected" : "") @(isLocked ? "is-locked" : "")" @key="encounter.Id">
                        <input type="radio" name="encounter" value="@encounter.Id" checked="@isSelected"
                               disabled="@(isLocked || CombatService.IsConnecting)" @onchange="() => SelectEncounter(encounter.Id)" />
                        <span class="encounter-details">
                            <span class="encounter-topline">
                                <strong>@encounter.Name</strong>
                                <span class="encounter-status">@(isLocked ? "Locked" : isSelected ? "Selected" : "Available")</span>
                            </span>
                            @if (!string.IsNullOrWhiteSpace(encounter.Description))
                            {
                                <span class="encounter-description">@encounter.Description</span>
                            }
                            <span class="encounter-meta">
                                <span>Difficulty · Tier @encounter.DifficultyRating</span>
                                <span>Guild level @encounter.RequiredGuildLevel required@(isLocked ? $" · Your level: {_guildProfile.Level}" : "")</span>
                            </span>
                        </span>
                    </label>
                }
            </fieldset>
        }
    </section>

    <section class="encounters-section" aria-labelledby="team-title">
        <div class="section-heading">
            <div>
                <p class="encounters-eyebrow">02 / Prepare your team</p>
                <h2 id="team-title">Draft your team</h2>
                <p>Select exactly three heroes. Select a hero again to remove them from the team.</p>
            </div>
            <span class="section-count" aria-live="polite">@_selectedHeroIds.Count / 3 selected</span>
        </div>

        @if (_rosterLoading)
        {
            <p class="encounters-state" role="status">Loading your roster...</p>
        }
        else if (_rosterError)
        {
            <div class="encounters-state state-error" role="alert">
                <h3>Roster unavailable</h3>
                <p>We couldn't load your heroes. Try again to prepare your team.</p>
                <button type="button" @onclick="LoadRosterAsync">Retry roster</button>
            </div>
        }
        else if (_heroes is { Count: 0 })
        {
            <div class="encounters-state">
                <h3>No heroes in your roster</h3>
                <p>You need three heroes to enter an encounter. Visit the Tavern to explore recruitment.</p>
                <a href="/tavern">Explore the Tavern <span aria-hidden="true">→</span></a>
            </div>
        }
        else if (_heroes is not null)
        {
            <fieldset class="hero-choices" aria-labelledby="team-title">
                <legend class="visually-hidden">Choose three heroes</legend>
                @foreach (var hero in _heroes)
                {
                    var isSelected = _selectedHeroIds.Contains(hero.Id);
                    <label class="hero-choice @(isSelected ? "is-selected" : "")" @key="hero.Id">
                        <input type="checkbox" checked="@isSelected" disabled="@(CombatService.IsConnecting || (!isSelected && _selectedHeroIds.Count == 3))"
                               @onchange="() => ToggleHeroSelection(hero.Id)" />
                        <img src="@AssetService.GetPortraitUrl(hero.DefinitionId)" alt="" loading="lazy" />
                        <span class="hero-details">
                            <strong>@hero.Name</strong>
                            <span>Level @hero.CurrentLevel</span>
                            <span class="hero-status">@(isSelected ? "On team" : _selectedHeroIds.Count == 3 ? "Team full" : "Select hero")</span>
                        </span>
                    </label>
                }
            </fieldset>
        }

        <div class="team-summary">
            <div class="team-summary-heading">
                <h3>Team slots</h3>
                <span>@_selectedHeroIds.Count of 3 filled</span>
            </div>
            <ol class="team-slots">
                @for (var slot = 0; slot < 3; slot++)
                {
                    var hero = slot < _selectedHeroIds.Count ? _heroes?.FirstOrDefault(h => h.Id == _selectedHeroIds[slot]) : null;
                    <li class="team-slot @(hero is null ? "slot-empty" : "")">
                        <span class="slot-number">@(slot + 1)</span>
                        @if (hero is null)
                        {
                            <span>Open slot</span>
                        }
                        else
                        {
                            <span class="slot-hero"><strong>@hero.Name</strong><small>Level @hero.CurrentLevel</small></span>
                            <button type="button" disabled="@CombatService.IsConnecting" aria-label="Remove @hero.Name from team" @onclick="() => ToggleHeroSelection(hero.Id)">Remove</button>
                        }
                    </li>
                }
            </ol>
        </div>

        <div class="encounters-action">
            <div>
                <strong>Enter the Arena</strong>
                <p>@(SelectedEncounter is null ? "Choose an available encounter." : $"Encounter: {SelectedEncounter.Name}.")
                    @_selectedHeroIds.Count / 3 heroes selected.</p>
            </div>
            <button type="button" disabled="@(!CanStartMatch)" @onclick="StartMatchAsync">
                @(CombatService.IsConnecting ? "Entering Arena..." : "Fight")
            </button>
        </div>
    </section>
</div>

@code {
    private List<EncounterSummaryDto>? _availableEncounters;
    private List<HeroDto>? _heroes;
    private GuildProfileDto? _guildProfile;
    private bool _encountersLoading = true;
    private bool _encountersError;
    private bool _rosterLoading = true;
    private bool _rosterError;

    private string? _selectedEncounterId;
    private readonly List<int> _selectedHeroIds = new();
    private EncounterSummaryDto? SelectedEncounter => _availableEncounters?.FirstOrDefault(e => e.Id == _selectedEncounterId);

    private bool CanStartMatch => SelectedEncounter is { } encounter
                               && _guildProfile is not null && _guildProfile.Level >= encounter.RequiredGuildLevel
                               && _heroes is not null && _selectedHeroIds.Count == 3
                               && !CombatService.IsConnecting;

    protected override async Task OnInitializedAsync() => await Task.WhenAll(LoadEncountersAsync(), LoadRosterAsync());

    private async Task LoadEncountersAsync()
    {
        _encountersLoading = true;
        _encountersError = false;
        _availableEncounters = null;
        _guildProfile = null;
        _selectedEncounterId = null;
        try
        {
            var encountersTask = Http.GetFromJsonAsync<List<EncounterSummaryDto>>("api/encounter");
            var profileTask = Http.GetFromJsonAsync<GuildProfileDto>("api/guild/profile");
            await Task.WhenAll(encountersTask, profileTask);
            _availableEncounters = await encountersTask;
            _guildProfile = await profileTask;
            _encountersError = _availableEncounters is null || _guildProfile is null;
        }
        catch (Exception)
        {
            _encountersError = true;
        }
        finally
        {
            _encountersLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadRosterAsync()
    {
        _rosterLoading = true;
        _rosterError = false;
        _heroes = null;
        _selectedHeroIds.Clear();
        try
        {
            _heroes = await Http.GetFromJsonAsync<List<HeroDto>>("api/guild/my-roster");
            _rosterError = _heroes is null;
        }
        catch (Exception)
        {
            _rosterError = true;
        }
        finally
        {
            _rosterLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SelectEncounter(string encounterId) => _selectedEncounterId = encounterId;

    private void ToggleHeroSelection(int heroId)
    {
        if (_selectedHeroIds.Contains(heroId))
            _selectedHeroIds.Remove(heroId);
        else if (_heroes?.Any(h => h.Id == heroId) == true && _selectedHeroIds.Count < 3)
            _selectedHeroIds.Add(heroId);
    }

    private async Task StartMatchAsync()
    {
        if (CanStartMatch)
        {
            await CombatService.StartEncounterCombatAsync(_selectedEncounterId!, _selectedHeroIds);
            NavManager.NavigateTo("/arena");
        }
    }
}
