@page "/news/{Id:int}"
@using System.Net
@using GuildArena.Shared.DTOs.News
@using GuildArena.Web.Components
@inject HttpClient Http
@inject NavigationManager NavManager

<PageTitle>@(_article?.Title ?? "News") — GuildArena</PageTitle>

<div class="article-page">
    <nav class="article-navigation" aria-label="Article navigation">
        <a href="/" class="article-back">← Back to home</a>
        @if (_article != null)
        {
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <div class="editor-actions">
                        <a href="/admin/news/edit/@Id" class="article-button">Edit article</a>
                        <button type="button" class="article-button danger" @ref="_deleteButton" @onclick="PromptDelete">Delete article</button>
                    </div>
                </Authorized>
            </AuthorizeView>
        }
    </nav>

    @if (_isLoading)
    {
        <div class="article-state" role="status"><h1>News from GuildArena</h1><p>Loading article…</p></div>
    }
    else if (_notFound)
    {
        <div class="article-state"><p class="eyebrow">Guild register</p><h1>Article not found</h1><p>This announcement is no longer available. Return home for the latest news.</p></div>
    }
    else if (_loadFailed)
    {
        <div class="article-state" role="alert"><h1>Article unavailable</h1><p>We couldn’t load this announcement. Please try again.</p><button type="button" class="article-button" @onclick="LoadArticleAsync">Retry article</button></div>
    }
    else if (_article != null)
    {
        <article>
            <header class="article-header">
                <p class="eyebrow">Guild register · Announcement</p>
                <h1>@_article.Title</h1>
                <p class="article-meta">Published <time datetime="@_article.CreatedAt.ToString("O")">@_article.CreatedAt.ToString("MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</time></p>
                @if (!string.IsNullOrWhiteSpace(_article.Summary))
                {
                    <p class="article-summary">@_article.Summary</p>
                }
            </header>
            <NewsImage ArticleId="Id" ImageUrl="_article.ImageUrl" Variant="article" />
            <div class="article-content">@_article.Content</div>
            <footer class="article-footer"><a href="/">← More news from GuildArena</a></footer>
        </article>
    }
</div>

@if (_showDeleteDialog)
{
    <div class="delete-backdrop" @onclick="CloseDeleteDialog">
        <section class="delete-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-title" aria-describedby="delete-description" @onclick:stopPropagation="true" @onkeydown="HandleDialogKeyDown">
            <span class="focus-boundary" tabindex="0" @onfocus="FocusLastControl" aria-label="End of dialog"></span>
            <p class="eyebrow">Editorial tools</p>
            <h2 id="delete-title">Delete this article?</h2>
            <p id="delete-description">“@_article?.Title” will be removed from the news. This action cannot be undone.</p>
            @if (_deleteError != null)
            {
                <p class="delete-error" role="alert">@_deleteError</p>
            }
            <div class="dialog-actions">
                <button type="button" class="article-button" @ref="_cancelButton" @onclick="CloseDeleteDialog" disabled="@_isDeleting">Cancel</button>
                <button type="button" class="article-button danger" @ref="_confirmButton" @onclick="ConfirmDeleteAsync" disabled="@_isDeleting">@(_isDeleting ? "Deleting…" : "Delete article")</button>
            </div>
            <span class="focus-boundary" tabindex="0" @onfocus="FocusFirstControl" aria-label="Start of dialog"></span>
        </section>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private NewsArticleDetailDto? _article;
    private bool _isLoading;
    private bool _notFound;
    private bool _loadFailed;
    private bool _showDeleteDialog;
    private bool _isDeleting;
    private bool _focusDialog;
    private string? _deleteError;
    private ElementReference _deleteButton, _cancelButton, _confirmButton;

    protected override Task OnParametersSetAsync()
    {
        _showDeleteDialog = false;
        return LoadArticleAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDialog)
        {
            _focusDialog = false;
            await _cancelButton.FocusAsync(preventScroll: true);
        }
    }

    private async Task LoadArticleAsync()
    {
        var articleId = Id;
        _isLoading = true;
        _notFound = _loadFailed = false;
        _article = null;
        try
        {
            using var response = await Http.GetAsync($"api/news/{articleId}");
            if (articleId != Id) return;
            if (response.StatusCode == HttpStatusCode.NotFound) _notFound = true;
            else
            {
                response.EnsureSuccessStatusCode();
                var article = await response.Content.ReadFromJsonAsync<NewsArticleDetailDto>()
                    ?? throw new InvalidOperationException("The article response was empty.");
                if (articleId == Id) _article = article;
            }
        }
        catch
        {
            if (articleId == Id) _loadFailed = true;
        }
        finally
        {
            if (articleId == Id) _isLoading = false;
        }
    }

    private void PromptDelete()
    {
        _deleteError = null;
        _showDeleteDialog = _focusDialog = true;
    }

    private async Task CloseDeleteDialog()
    {
        if (_isDeleting) return;
        _showDeleteDialog = false;
        await _deleteButton.FocusAsync(preventScroll: true);
    }

    private Task FocusFirstControl() => _cancelButton.FocusAsync().AsTask();
    private Task FocusLastControl() => _confirmButton.FocusAsync().AsTask();
    private async Task HandleDialogKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") await CloseDeleteDialog();
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_isDeleting) return;
        _isDeleting = true;
        _deleteError = null;
        try
        {
            using var response = await Http.DeleteAsync($"api/news/{Id}");
            if (response.IsSuccessStatusCode) NavManager.NavigateTo("/");
            else _deleteError = "We couldn’t delete this article. Please try again.";
        }
        catch
        {
            _deleteError = "Connection unavailable. Check the latest news before retrying: the article may already have been deleted.";
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
