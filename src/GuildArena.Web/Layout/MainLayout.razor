@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using GuildArena.Web.Security
@using GuildArena.Web.State
@using GuildArena.Web.Components
@inject AuthenticationStateProvider AuthState
@inject HttpClient Http
@inject NavigationManager NavManager
@inject ICombatStateService CombatState

<div class="page game-container" @onkeydown="HandleMenuKeyDown">
    <header class="site-header">
        <a class="mobile-brand" href="/" aria-label="GuildArena home">
            <img src="/images/ui/estandarte.svg" alt="" width="28" height="28" />
            <span>GuildArena</span>
        </a>
        <span class="header-location">GuildArena</span>
        <div class="header-actions">
            <AuthorizeView>
                <Authorizing>
                    <span class="header-status" role="status">Connecting to server...</span>
                </Authorizing>
                <Authorized>
                    <div class="user-profile">
                        <NavLink href="account" Match="NavLinkMatch.All" class="account-link" aria-label="Account settings">
                            <SettingsIcon />
                            <span class="account-name">Account settings</span>
                        </NavLink>
                        <button class="logout-button" @onclick="ExecuteLogout">Logout</button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    @if (AuthState is CookieAuthenticationStateProvider { IsCheckUnavailable: true })
                    {
                        <span class="header-status" role="status">Connection unavailable</span>
                    }
                    else
                    {
                        <a href="/login" class="login-button">Login to Play</a>
                    }
                </NotAuthorized>
            </AuthorizeView>
        </div>
        <button class="menu-toggle" type="button" @ref="_menuToggle" @onclick="ToggleMenu"
                aria-label="Toggle navigation" aria-controls="game-navigation" aria-expanded="@(_isMenuOpen ? "true" : "false")">
            <span aria-hidden="true">☰</span>
        </button>
    </header>

    <aside class="sidebar @(_isMenuOpen ? "mobile-open" : "")">
        <a class="sidebar-brand" href="/" aria-label="GuildArena home">
            <img src="/images/ui/estandarte.svg" alt="" width="31" height="31" />
            <span>GuildArena</span>
        </a>
        <NavMenu OnNavigate="CloseMenu" />
    </aside>

        <main class="main-content" tabindex="-1" aria-label="Main content">
        <article class="content">
            @if (_combatRecoveryFailed)
            {
                <div class="combat-recovery" role="alert">
                    <p>An active combat was found, but we couldn't reconnect. Check your connection and try again.</p>
                    <button type="button" @onclick="RetryCombatRecoveryAsync">Reconnect to combat</button>
                </div>
            }
            @Body
        </article>
    </main>
</div>

@code {
    private bool _isMenuOpen;
    private bool _combatRecoveryFailed;
    private ElementReference _menuToggle;

    private void ToggleMenu() => _isMenuOpen = !_isMenuOpen;

    private async Task CloseMenu()
    {
        if (_isMenuOpen)
        {
            _isMenuOpen = false;
            await _menuToggle.FocusAsync(preventScroll: true);
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _isMenuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task HandleMenuKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && _isMenuOpen)
        {
            await CloseMenu();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        NavManager.LocationChanged += HandleLocationChanged;
        var authState = await AuthState.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            // 1. Sempre que a SPA carrega (F5), perguntamos à API se há combate ativo.
            // (Isto só corre 1x no carregamento da página, não corre em navegação normal de menus)
            var activeCombat = await CombatState.CheckActiveCombatAsync();

            if (activeCombat != null && activeCombat.HasActiveCombat)
            {
                // 2. O Blazor perdeu a memória do combate (porque fizemos F5)?
                if (string.IsNullOrEmpty(CombatState.CombatId))
                {
                    // Descarrega o estado da API e liga o SignalR!
                    if (!await CombatState.RejoinCombatAsync(activeCombat.CombatId!, activeCombat.MatchType))
                    {
                        _combatRecoveryFailed = true;
                        return;
                    }
                }

                // 3. Ele tentou ir para outra página que não a Arena?
                if (!NavManager.Uri.Contains("/arena"))
                {
                    // Forçamos o regresso à arena!
                    NavManager.NavigateTo("/arena");
                }
            }
        }
    }

    private async Task RetryCombatRecoveryAsync()
    {
        var active = await CombatState.CheckActiveCombatAsync();
        if (active is null) return;

        if (!active.HasActiveCombat)
        {
            _combatRecoveryFailed = false;
            return;
        }

        if (await CombatState.RejoinCombatAsync(active.CombatId!, active.MatchType))
        {
            _combatRecoveryFailed = false;
            NavManager.NavigateTo("/arena");
        }
    }

    public void Dispose() => NavManager.LocationChanged -= HandleLocationChanged;

    private async Task ExecuteLogout()
    {
        try
        {
            await Http.PostAsync("api/account/logout", null);
            var customAuthState = (CookieAuthenticationStateProvider)AuthState;
            customAuthState.NotifyAuthStatusChanged();
            NavManager.NavigateTo("/login");
        }
        catch { }
    }
}
